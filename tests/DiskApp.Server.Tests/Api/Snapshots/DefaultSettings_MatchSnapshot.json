{
  "hotkeys": {
    "quickSearch": "Ctrl+Alt+D",
    "triage": "Ctrl+Alt+I",
    "quickSwitch": "Ctrl+Alt+G",
    "mainWindow": "Ctrl+Alt+O",
    "dropWindow": "Ctrl+Alt+B"
  },
  "appearance": {
    "theme": "System",
    "backdrop": "Mica",
    "useSystemAccent": true,
    "reduceMotion": false,
    "hardwareAcceleration": false,
    "fontScale": 1,
    "compact": false,
    "language": "system"
  },
  "indexing": {
    "exclusions": [
      {
        "kind": "Glob",
        "pattern": "$RECYCLE.BIN"
      },
      {
        "kind": "Glob",
        "pattern": "System Volume Information"
      },
      {
        "kind": "Glob",
        "pattern": "$Recycle.Bin"
      },
      {
        "kind": "Glob",
        "pattern": "node_modules"
      },
      {
        "kind": "Glob",
        "pattern": ".git"
      },
      {
        "kind": "Glob",
        "pattern": "bin"
      },
      {
        "kind": "Glob",
        "pattern": "obj"
      },
      {
        "kind": "Glob",
        "pattern": "*.tmp"
      },
      {
        "kind": "Glob",
        "pattern": "~$*"
      },
      {
        "kind": "Glob",
        "pattern": "*.crdownload"
      },
      {
        "kind": "Glob",
        "pattern": "*.part"
      }
    ],
    "includeHiddenByDefault": false,
    "includeSystemByDefault": false,
    "batchSize": 5000,
    "watcherDebounceMilliseconds": 400,
    "reconcileIntervalMinutes": 360,
    "followReparsePoints": false,
    "maxScanParallelism": 0
  },
  "search": {
    "pageSize": 50,
    "candidateLimit": 2000,
    "historyLimit": 100,
    "frecencyHalfLifeDays": 30,
    "rankingPreset": "Balanced",
    "fuzzy": true,
    "showSuggestionsOnEmpty": true
  },
  "tray": {
    "startMinimized": true,
    "closeToTray": true,
    "confirmExitDuringOperations": true,
    "autoStart": false
  },
  "add": {
    "recentTargets": [],
    "clipboardNameTemplate": "{date}_{time}_{title}"
  },
  "experimental": {
    "quickSwitch": false
  },
  "popup": {
    "monitor": "Cursor",
    "hideOnDeactivate": true,
    "showPath": true,
    "showSize": true,
    "showDate": true
  },
  "diagnostics": {
    "logLevel": "Information"
  },
  "onboarding": {
    "completed": false,
    "tipsShown": []
  },
  "sorting": {
    "inboxes": [],
    "workFolders": [],
    "settleSeconds": 5,
    "ignorePatterns": [
      "*.crdownload",
      "*.part",
      "*.partial",
      "*.download",
      "*.tmp",
      "~$*",
      "desktop.ini",
      "Thumbs.db",
      ".DS_Store"
    ]
  }
}
