<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DiskApp.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:DiskApp.UI.Views"
        xmlns:vm="using:DiskApp.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="240"
        x:Class="DiskApp.Desktop.Windows.DropWindow"
        x:DataType="vm:DropWindowViewModel"
        Title="{loc:Str Drop.WindowTitle}"
        Width="360" Height="240"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="AcrylicBlur, Blur, None"
        TransparencyBackgroundFallback="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Background="Transparent">
    <!-- Окно Drag&Drop у значка в трее (PLAN.md, этап 18, ADR-0011): как окно поиска — без рамки, поверх всех, Acrylic
         со сплошной подложкой, скруглённые углы через DWM. В отличие от него не прячется при потере фокуса: за файлами
         пользователь переключается в Проводник. Прячется по Esc, кнопке закрытия, щелчку по значку и хоткею. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
    </Window.KeyBindings>
    <Panel x:Name="Root">
        <Border x:Name="Solid" CornerRadius="8" IsHitTestVisible="False" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <ExperimentalAcrylicBorder x:Name="Acrylic" CornerRadius="8" IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                             TintColor="{DynamicResource SolidBackgroundFillColorBase}"
                                             TintOpacity="0.72"
                                             MaterialOpacity="0.6" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Padding="12">
            <LayoutTransformControl x:Name="Scaler">
                <views:DropView />
            </LayoutTransformControl>
        </Border>
    </Panel>
</Window>
