<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:DiskApp.UI.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:DiskApp.UI.Views"
        xmlns:vm="using:DiskApp.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="120"
        x:Class="DiskApp.Desktop.Windows.NotificationCardWindow"
        x:DataType="vm:NotificationCardViewModel"
        Title="{loc:Str Notifications.WindowTitle}"
        Width="360"
        SizeToContent="Height"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Transparent">
    <!-- Тихая карточка уведомления у области уведомлений (PLAN.md, этап 21.1, ADR-0013): поверх всех, без рамки, без
         кнопки на панели задач и без фокуса — не перебивает ввод в другом окне. Уходит сама, пока над ней нет указателя. -->
    <Border CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <views:NotificationCardView />
    </Border>
</Window>
