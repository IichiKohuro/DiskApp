<Project Sdk="Microsoft.NET.Sdk">

  <!-- Точка входа десктопа: окна, трей, глобальные хоткеи, один экземпляр, автозапуск, сервер внутри процесса. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DiskApp</AssemblyName>
    <ApplicationIcon>Assets\DiskApp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- P/Invoke через LibraryImport с указателями на функции (хоткей, message-only окно). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконка трея и окон (avares://DiskApp/Assets/DiskApp.ico); тот же файл — иконка exe (ApplicationIcon).
         Файл лежит внутри проекта: ресурс за его пределами в avares-индекс не попадает. -->
    <AvaloniaResource Include="Assets\DiskApp.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskApp.Server\DiskApp.Server.csproj" />
    <ProjectReference Include="..\DiskApp.UI\DiskApp.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <!-- Инструменты разработчика Avalonia 12 (F12) только в отладочной сборке. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiskApp.Desktop.Tests" />
  </ItemGroup>

  <!-- Сторонние компоненты для раздела «О программе» (PLAN.md, этап 9.1): список строится при сборке из версий пакетов
       Directory.Packages.props; пакеты тестов и инструментов в поставку не входят и в список не попадают. -->
  <Target Name="WriteThirdPartyList" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_ThirdPartyPackage Include="@(PackageVersion)"
                          Exclude="xunit.v3;Microsoft.Testing.Extensions.CodeCoverage;Microsoft.Testing.Extensions.TrxReport;Shouldly;NSubstitute;BenchmarkDotNet;Avalonia.Headless;AvaloniaUI.DiagnosticsSupport" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)third-party.txt"
                      Lines="@(_ThirdPartyPackage->'%(Identity) %(Version)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)third-party.txt" LogicalName="DiskApp.ThirdParty.txt" />
      <FileWrites Include="$(IntermediateOutputPath)third-party.txt" />
    </ItemGroup>
  </Target>

</Project>
