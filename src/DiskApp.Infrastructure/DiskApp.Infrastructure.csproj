<Project Sdk="Microsoft.NET.Sdk">

  <!-- Реализации интерфейсов ядра: SQLite (Microsoft.Data.Sqlite + Dapper, миграции, FTS5), файловая система,
       FileSystemWatcher, Windows Shell. Зависит только от Core. -->

  <ItemGroup>
    <ProjectReference Include="..\DiskApp.Core\DiskApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <!-- Миграции схемы: SQL-скрипты V001__name.sql как встроенные ресурсы, применяются по порядку (SqliteMigrator). -->
  <ItemGroup>
    <EmbeddedResource Include="Sqlite\Migrations\*.sql" LogicalName="DiskApp.Infrastructure.Sqlite.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiskApp.Infrastructure.Tests" />
    <InternalsVisibleTo Include="DiskApp.Benchmarks" />
  </ItemGroup>

</Project>
