<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общие стили поверх FluentAvalonia: карточки, второстепенный текст, списки результатов, поле поиска.
         Цвета только из ресурсов темы (DynamicResource), чтобы светлая и тёмная темы и акцент системы работали сами. -->

    <!-- Карточка: фон слоя, тонкая обводка, радиус 8 -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Кнопка-карточка для быстрых действий -->
    <Style Selector="Button.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.card:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

    <!-- Текст второго и третьего плана -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Заголовок раздела страницы -->
    <Style Selector="TextBlock.section">
        <Setter Property="Theme" Value="{StaticResource BodyStrongTextBlockStyle}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- Список результатов: прозрачный фон, компактные строки со скруглением 4 -->
    <Style Selector="ListBox.results">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.results ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Чипы фильтров и подсказок под полем быстрого поиска -->
    <Style Selector="Button.filter, Button.suggestion">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.filter">
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Button.filter.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.filter.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.suggestion.history">
        <Setter Property="CornerRadius" Value="12,0,0,12" />
    </Style>
    <Style Selector="Button.remove">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0,12,12,0" />
        <Setter Property="BorderThickness" Value="0,1,1,1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Пример синтаксиса в подсказке «?» -->
    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>

    <!-- Свойства файла в панели сведений: подпись слева, значение справа -->
    <Style Selector="Grid.details > TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,3,16,3" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Grid.details > :is(TextBlock).value">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Карточка корня: недоступный корень или ошибка выделены рамкой и цветом состояния -->
    <Style Selector="Border.card.root.problem">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Border.card.root.problem TextBlock.state">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <!-- Кнопки панели команд «Обзора»: компактные, без рамки -->
    <Style Selector=":is(Button).tool">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- Плитка «Обзора» -->
    <Style Selector="ListBox.tiles">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem">
        <Setter Property="Padding" Value="6,8" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Точка состояния индекса в панели навигации -->
    <Style Selector="Ellipse.health">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="Ellipse.health.indexing">
        <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Ellipse.health.warning">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Ellipse.health.error">
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="Ellipse.health.starting">
        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Поле поиска в заголовке главного окна -->
    <Style Selector="TextBox.header-search">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Подпись клавиши в пункте меню: справа, приглушённая -->
    <Style Selector="TextBlock.gesture">
        <Setter Property="Margin" Value="32,0,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Строка-заголовок секции: не выбирается и не реагирует на мышь -->
    <Style Selector="ListBox.results ListBoxItem.header">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Поле быстрого поиска: крупный шрифт -->
    <Style Selector="TextBox.search">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Чип: номер строки, этап плана -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.chip.accent">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.chip.accent > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>

    <!-- Строка файла: обычная высота и компактный режим (настройка «Компактные списки», этап 9.1) -->
    <Style Selector="Grid.hit">
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector=":is(Control).compact Grid.hit">
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector=":is(Control).compact ListBox.results ListBoxItem">
        <Setter Property="Padding" Value="8,1" />
    </Style>

    <!-- Разделы страницы настроек -->
    <Style Selector="ListBox.settings-nav">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Чип тега: точка цвета тега и имя (этап 8.7) -->
    <Style Selector="Border.tag">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,0,7,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tag TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Цветная точка тега в списках страниц «Теги» и «Коллекции» -->
    <Style Selector="Ellipse.swatch">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
