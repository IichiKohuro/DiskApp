<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="using:DiskApp.UI.Models"
                    xmlns:c="using:DiskApp.UI.Controls"
                    xmlns:ic="using:FluentIcons.Avalonia">
    <!-- Чип тега: свой — на подложке, авто-тег папки (этап 19) — контуром, с подсказкой, от какой он папки -->
    <DataTemplate x:Key="TagChipTemplate" DataType="m:TagLabel">
        <Border Classes="tag" Classes.inherited="{Binding IsInherited}" ToolTip.Tip="{Binding Hint}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Color, Converter={x:Static c:TagConverters.Brush}}" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Строка файла в списках результатов, недавних и коллекций: иконка по виду, имя с подсветкой, папка,
         теги, размер и дата, звезда избранного и номер для Ctrl+1…9. -->
    <DataTemplate x:Key="FileHitTemplate" DataType="m:SearchHit">
        <Grid Classes="hit" ColumnDefinitions="Auto,*,Auto,Auto">
            <!-- Иконка Windows или миниатюра с сервера; до загрузки и без неё — заглушка по виду файла на подложке -->
            <c:FileIcon Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="6"
                        VerticalAlignment="Center"
                        IconSize="24"
                        PreferThumbnail="True"
                        Entry="{Binding Entry}"
                        Symbol="{Binding Symbol}"
                        FallbackBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="1">
                <DockPanel>
                    <ic:SymbolIcon DockPanel.Dock="Right"
                                   Symbol="Star"
                                   IconVariant="Filled"
                                   FontSize="14"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   IsVisible="{Binding IsFavorite}" />
                    <ic:SymbolIcon DockPanel.Dock="Right"
                                   Symbol="{Binding AvailabilitySymbol}"
                                   FontSize="14"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip.Tip="{Binding AvailabilityText}"
                                   IsVisible="{Binding IsUnavailable}" />
                    <c:HighlightTextBlock Text="{Binding Entry.Name}"
                                          Highlight="{Binding Highlight}"
                                          HighlightRanges="{Binding Entry.NameHighlights}"
                                          FontSize="14"
                                          VerticalAlignment="Center" />
                </DockPanel>
                <!-- Путь сжимается с многоточием, а не наезжает на размер и дату, когда строка узкая (масштаб 150 %, этап 9.4) -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="secondary"
                               FontSize="12"
                               Text="{Binding DirectoryText}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ShowPath}" />
                    <ItemsControl Grid.Column="1"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding Entry.TagLabels}"
                                  ItemTemplate="{StaticResource TagChipTemplate}"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HasTags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" MinWidth="72">
                <TextBlock Classes="secondary" FontSize="12" HorizontalAlignment="Right" Text="{Binding SizeText}" IsVisible="{Binding ShowSize}" />
                <TextBlock Classes="tertiary" FontSize="12" HorizontalAlignment="Right" Text="{Binding ModifiedText}" IsVisible="{Binding ShowDate}" />
            </StackPanel>

            <Border Grid.Column="3"
                    Classes="chip"
                    Margin="12,0,0,0"
                    MinWidth="22"
                    IsVisible="{Binding HasNumber}">
                <TextBlock Text="{Binding NumberText}" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Заголовок секции в списке результатов: «Недавно открытые», «Закреплённые», «Недавно изменённые» -->
    <DataTemplate x:Key="SectionHeaderTemplate" DataType="m:ResultSectionHeader">
        <TextBlock Classes="section" Margin="0,8,0,0" Text="{Binding Title}" />
    </DataTemplate>

    <!-- Строка списка быстрого поиска: файл или заголовок секции -->
    <c:ResultRowTemplate x:Key="ResultRowTemplate"
                         Hit="{StaticResource FileHitTemplate}"
                         Header="{StaticResource SectionHeaderTemplate}" />
</ResourceDictionary>
