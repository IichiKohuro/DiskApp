<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="using:DiskApp.UI.Models"
                    xmlns:c="using:DiskApp.UI.Controls"
                    xmlns:ic="using:FluentIcons.Avalonia">
    <!-- Строка файла в списках результатов, недавних и коллекций: иконка по виду, имя с подсветкой, папка,
         теги, размер и дата, звезда избранного и номер для Ctrl+1…9. -->
    <DataTemplate x:Key="FileHitTemplate" DataType="m:SearchHit">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="40">
            <Border Grid.Column="0"
                    Width="34" Height="34"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <ic:SymbolIcon Symbol="{Binding Symbol}"
                               FontSize="20"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="1">
                <DockPanel>
                    <ic:SymbolIcon DockPanel.Dock="Right"
                                   Symbol="Star"
                                   IconVariant="Filled"
                                   FontSize="14"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   IsVisible="{Binding IsFavorite}" />
                    <c:HighlightTextBlock Text="{Binding Entry.Name}"
                                          Highlight="{Binding Highlight}"
                                          HighlightRanges="{Binding Entry.NameHighlights}"
                                          FontSize="14"
                                          VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="secondary"
                               FontSize="12"
                               Text="{Binding DirectoryText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="tertiary"
                               FontSize="12"
                               Text="{Binding TagsText}"
                               IsVisible="{Binding HasTags}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" MinWidth="72">
                <TextBlock Classes="secondary" FontSize="12" HorizontalAlignment="Right" Text="{Binding SizeText}" />
                <TextBlock Classes="tertiary" FontSize="12" HorizontalAlignment="Right" Text="{Binding ModifiedText}" />
            </StackPanel>

            <Border Grid.Column="3"
                    Classes="chip"
                    Margin="12,0,0,0"
                    MinWidth="22"
                    IsVisible="{Binding HasNumber}">
                <TextBlock Text="{Binding NumberText}" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
