<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             xmlns:views="using:DiskApp.UI.Views"
             x:Class="DiskApp.UI.App"
             RequestedThemeVariant="Default">
    <!-- RequestedThemeVariant="Default" следует системной светлой или тёмной теме; настройки меняют его через IThemeService. -->

    <Application.Styles>
        <!-- Тема Windows 11: системная светлая/тёмная, акцентный цвет пользователя, системный шрифт (Segoe UI Variable). -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <StyleInclude Source="avares://DiskApp.UI/Styles/AppStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DiskApp.UI/Styles/Tokens.axaml" />
                <ResourceInclude Source="avares://DiskApp.UI/Styles/IconColors.axaml" />
                <ResourceInclude Source="avares://DiskApp.UI/Styles/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Панель заголовка FAAppWindow тянет окно, только если у неё есть фон: в светлой теме FluentAvalonia ресурса
                 TitleBarBackground нет, и главное окно нельзя было перетащить (замечание пользователя, 2026-10-11). Ключ в
                 ресурсах окна FAAppWindow стирает сам, поэтому прозрачные кисти — здесь, для обеих тем. -->
            <SolidColorBrush x:Key="TitleBarBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TitleBarBackgroundInactive" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>

    <!-- Соответствие ViewModel → View для страниц главного окна (явное, без рефлексии). -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:QuickSearchViewModel">
            <views:SearchPageView />
        </DataTemplate>
        <DataTemplate DataType="vm:BrowseViewModel">
            <views:BrowseView />
        </DataTemplate>
        <DataTemplate DataType="vm:OperationsViewModel">
            <views:OperationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SortingViewModel">
            <views:SortingView />
        </DataTemplate>
        <DataTemplate DataType="vm:CollectionsViewModel">
            <views:CollectionsView />
        </DataTemplate>
        <DataTemplate DataType="vm:TagsViewModel">
            <views:TagsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="vm:NotesViewModel">
            <views:NotesView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlaceholderPageViewModel">
            <views:PlaceholderPageView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
