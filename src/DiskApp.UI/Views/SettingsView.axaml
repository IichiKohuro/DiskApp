<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             xmlns:svc="using:DiskApp.UI.Services"
             xmlns:text="using:DiskApp.UI.Text"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="DiskApp.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Design.DataContext="{x:Static vm:DesignData.Settings}">
    <!-- Настройки в стиле «Параметров» Windows 11 (PLAN.md, этап 9.1): разделы слева, SettingsExpander справа.
         Каждое изменение сохраняется сразу и применяется без перезапуска; отклонённое значение возвращается с пояснением. -->
    <Grid Margin="16,12,16,8" RowDefinitions="Auto,*" ColumnDefinitions="220,*">
        <TextBlock Grid.ColumnSpan="2" Theme="{StaticResource TitleLargeTextBlockStyle}" Text="{loc:Str Settings.Settings}" Margin="0,0,0,12" />

        <ListBox x:Name="CategoriesList" AutomationProperties.Name="{loc:Str A11y.SettingsSections}" Grid.Row="1" Classes="settings-nav" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsCategory">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                        <ui:FASymbolIcon Symbol="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <StackPanel Spacing="4" MaxWidth="{StaticResource PageMaxWidth}" Margin="0,0,12,16">
                <ui:FAInfoBar IsOpen="{Binding HasSettingsNote}" IsClosable="False" Severity="Warning" Title="{loc:Str Settings.Settings}" Message="{Binding SettingsNote}" Margin="0,0,0,8" />

                <!-- Внешний вид -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=appearance}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Appearance}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.Language}" Description="{loc:Str Settings.LanguageDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Globe" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.Language}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Theme}" Description="{loc:Str Settings.LightDarkOrAsInWindows}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="DarkTheme" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.Theme}" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.WindowBackground}" Description="{loc:Str Settings.MicaInTheMainWindowAnd}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="ColorBackground" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.WindowBackground}" ItemsSource="{Binding Backdrops}" SelectedItem="{Binding SelectedBackdrop, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.AccentColor}" Description="{loc:Str Settings.TheWindowsColorOrYourOwn}" IsExpanded="{Binding !UseSystemAccent}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="ColorFill" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.AccentColor}" IsChecked="{Binding UseSystemAccent, Mode=TwoWay}" OnContent="{loc:Str Settings.LanguageSystem}" OffContent="{loc:Str Settings.Custom}" />
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.CustomColor}" IsEnabled="{Binding !UseSystemAccent}">
                            <ui:FASettingsExpanderItem.Footer>
                                <ItemsControl ItemsSource="{Binding AccentChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccentChoice">
                                            <Button AutomationProperties.Name="{Binding AccessibleName}" Classes="swatch" ToolTip.Tip="{Binding Color}"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectAccentCommand}" CommandParameter="{Binding}">
                                                <Panel>
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Color}" />
                                                    <ic:SymbolIcon Symbol="Checkmark" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSelected}" />
                                                </Panel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Scale}" Description="{loc:Str Settings.SizeOfTextAndControlsIn}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="FontSize" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.Scale}" ItemsSource="{Binding FontScales}" SelectedItem="{Binding SelectedFontScale, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.CompactLists}" Description="{loc:Str Settings.LowerResultRowsMoreFilesFit}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="List" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.CompactLists}" IsChecked="{Binding Compact, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.ReduceMotion}" Description="{loc:Str Settings.NoAnimationsForWindowsAndTransitions}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Pause" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.ReduceMotion}" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.HardwareAcceleration}" Description="{loc:Str Settings.HardwareAccelerationDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Pictures" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.HardwareAcceleration}" IsChecked="{Binding HardwareAcceleration, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem AutomationProperties.Name="{loc:Str Settings.RestartToApply}" IsVisible="{Binding HardwareAccelerationRestartNeeded}">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{loc:Str Settings.RestartToApply}" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Горячие клавиши (этап 18.1): быстрый поиск, главное окно, окно Drag&Drop, Quick Switch -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=hotkeys}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Hotkeys}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.QuickSearch}"
                                           Description="{loc:Str Settings.ShowOrHideTheQuickSearch}"
                                           IsExpanded="{Binding Hotkeys.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Find" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Border Classes="chip" Padding="10,4" IsVisible="{Binding !IsRecordingQuickSearch}">
                                    <TextBlock Text="{Binding Hotkeys.QuickSearchText}" FontSize="13" />
                                </Border>
                                <Border Classes="chip accent" Padding="10,4" IsVisible="{Binding IsRecordingQuickSearch}">
                                    <TextBlock Text="{loc:Str Settings.PressTheShortcutEscCancels}" FontSize="13" />
                                </Border>
                                <Button Content="{loc:Str Settings.Change}" Command="{Binding StartRecordingCommand}" CommandParameter="{x:Static svc:HotkeyTarget.QuickSearch}" />
                                <Button Content="{loc:Str Settings.Default}" Command="{Binding ResetHotkeyCommand}" CommandParameter="{x:Static svc:HotkeyTarget.QuickSearch}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem AutomationProperties.Name="{Binding Hotkeys.Message}" IsVisible="{Binding Hotkeys.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Hotkeys.Message}" TextWrapping="Wrap" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.MainWindowHotkey}"
                                           Description="{loc:Str Settings.MainWindowHotkeyText}"
                                           IsExpanded="{Binding Hotkeys.MainWindowMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Home" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Border Classes="chip" Padding="10,4" IsVisible="{Binding !IsRecordingMainWindow}">
                                    <TextBlock Text="{Binding Hotkeys.MainWindowText}" FontSize="13" />
                                </Border>
                                <Border Classes="chip accent" Padding="10,4" IsVisible="{Binding IsRecordingMainWindow}">
                                    <TextBlock Text="{loc:Str Settings.PressTheShortcutEscCancels}" FontSize="13" />
                                </Border>
                                <Button Content="{loc:Str Settings.Change}" Command="{Binding StartRecordingCommand}" CommandParameter="{x:Static svc:HotkeyTarget.MainWindow}" />
                                <Button Content="{loc:Str Settings.Default}" Command="{Binding ResetHotkeyCommand}" CommandParameter="{x:Static svc:HotkeyTarget.MainWindow}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem AutomationProperties.Name="{Binding Hotkeys.MainWindowMessage}" IsVisible="{Binding Hotkeys.MainWindowMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Hotkeys.MainWindowMessage}" TextWrapping="Wrap" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.DropWindowHotkey}"
                                           Description="{loc:Str Settings.DropWindowHotkeyText}"
                                           IsExpanded="{Binding Hotkeys.DropWindowMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Download" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Border Classes="chip" Padding="10,4" IsVisible="{Binding !IsRecordingDropWindow}">
                                    <TextBlock Text="{Binding Hotkeys.DropWindowText}" FontSize="13" />
                                </Border>
                                <Border Classes="chip accent" Padding="10,4" IsVisible="{Binding IsRecordingDropWindow}">
                                    <TextBlock Text="{loc:Str Settings.PressTheShortcutEscCancels}" FontSize="13" />
                                </Border>
                                <Button Content="{loc:Str Settings.Change}" Command="{Binding StartRecordingCommand}" CommandParameter="{x:Static svc:HotkeyTarget.DropWindow}" />
                                <Button Content="{loc:Str Settings.Default}" Command="{Binding ResetHotkeyCommand}" CommandParameter="{x:Static svc:HotkeyTarget.DropWindow}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem AutomationProperties.Name="{Binding Hotkeys.DropWindowMessage}" IsVisible="{Binding Hotkeys.DropWindowMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Hotkeys.DropWindowMessage}" TextWrapping="Wrap" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Quick Switch" Description="{loc:Str Settings.ShortcutInTheSaveOrOpen}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Folder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Border Classes="chip" Padding="10,4" IsVisible="{Binding !IsRecordingQuickSwitch}">
                                    <TextBlock Text="{Binding QuickSwitchHotkeyText}" FontSize="13" />
                                </Border>
                                <Border Classes="chip accent" Padding="10,4" IsVisible="{Binding IsRecordingQuickSwitch}">
                                    <TextBlock Text="{loc:Str Settings.PressTheShortcutEscCancels}" FontSize="13" />
                                </Border>
                                <Button Content="{loc:Str Settings.Change}" Command="{Binding StartRecordingCommand}" CommandParameter="{x:Static svc:HotkeyTarget.QuickSwitch}" />
                                <Button Content="{loc:Str Settings.Default}" Command="{Binding ResetHotkeyCommand}" CommandParameter="{x:Static svc:HotkeyTarget.QuickSwitch}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <TextBlock Margin="16,-2,16,6" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding HotkeyNote}" IsVisible="{Binding HasHotkeyNote}" />
                </StackPanel>

                <!-- Быстрый поиск -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=quick}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.QuickSearch}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.Monitor}" Description="{loc:Str Settings.WhereToShowTheQuickSearch}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="DockLeft" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.Monitor}" ItemsSource="{Binding PopupMonitors}" SelectedItem="{Binding SelectedPopupMonitor, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.HideWhenFocusIsLost}" Description="{loc:Str Settings.AClickInAnotherWindowCloses}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="View" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.HideWhenFocusIsLost}" IsChecked="{Binding HideOnDeactivate, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.RowDetails}" Description="{loc:Str Settings.WhatToShowNextToThe}" IsExpanded="True">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Document" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.Folder}">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch AutomationProperties.Name="{loc:Str Settings.Folder}" IsChecked="{Binding ShowPath, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.Size}">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch AutomationProperties.Name="{loc:Str Settings.Size}" IsChecked="{Binding ShowSize, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.DateModified}">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch AutomationProperties.Name="{loc:Str Settings.DateModified}" IsChecked="{Binding ShowDate, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.SearchWindowKeys}" Description="{loc:Str Settings.WhatKeysDoWhileTheQuick}" ItemsSource="{Binding KeyMap}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Keyboard" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeyMapEntry">
                                <Grid ColumnDefinitions="180,*">
                                    <Border Classes="chip" HorizontalAlignment="Left" Padding="8,2">
                                        <TextBlock Text="{Binding Keys}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ui:FASettingsExpander.ItemTemplate>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Поиск -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=search}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Search}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.FuzzySearch}" Description="{loc:Str Settings.WhenThereAreFewExactMatches}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Find" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.FuzzySearch}" IsChecked="{Binding Fuzzy, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.PicksForAnEmptyQuery}" Description="{loc:Str Settings.RecentlyOpenedPinnedAndChangedFiles}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.PicksForAnEmptyQuery}" IsChecked="{Binding ShowSuggestionsOnEmpty, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.ResultOrder}" Description="{loc:Str Settings.WhatMattersMoreANameMatch}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Sort" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.ResultOrder}" ItemsSource="{Binding RankingPresets}" SelectedItem="{Binding SelectedRankingPreset, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.CandidatesBeforeRanking}" Description="{loc:Str Settings.MoreGivesABetterOrderOn}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Filter" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <NumericUpDown AutomationProperties.Name="{loc:Str Settings.CandidatesBeforeRanking}" Value="{Binding CandidateLimit, Mode=TwoWay}" Minimum="100" Maximum="5000" Increment="100" FormatString="0" MinWidth="150" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.QueryHistory}" Description="{loc:Str Settings.HowManyQueriesToRememberFor}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <NumericUpDown AutomationProperties.Name="{loc:Str Settings.QueryHistory}" Value="{Binding HistoryLimit, Mode=TwoWay}" Minimum="0" Maximum="1000" Increment="10" FormatString="0" MinWidth="150" />
                                <Button Content="{loc:Str Settings.Clear2}" Command="{Binding ClearHistoryCommand}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Индекс -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=index}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Index}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.Roots}" Description="{loc:Str Settings.FoldersAndDrivesThatAreSearched}" IsExpanded="True" ItemsSource="{Binding RootItems}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Folder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Content="{loc:Str Settings.AddFolder}" Command="{Binding AddRootFolderCommand}" />
                                <Button Content="{loc:Str Settings.Drive}">
                                    <Button.Flyout>
                                        <Flyout>
                                            <ItemsControl ItemsSource="{Binding Drives}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding}"
                                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).AddDriveCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="vm:RootSettingsItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                    <ic:SymbolIcon Grid.RowSpan="2" Symbol="Folder" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource FolderIconBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Root.Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Root.Path}" />
                                        <TextBlock Classes="tertiary" FontSize="12" Text="{Binding StateText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button AutomationProperties.Name="{loc:Str Settings.Rescan2}" Classes="tool" ToolTip.Tip="{loc:Str Settings.Rescan2}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RescanRootCommand}" CommandParameter="{Binding}">
                                            <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
                                        </Button>
                                        <Button AutomationProperties.Name="{loc:Str Settings.RemoveFromIndexFilesStay}" Classes="tool" ToolTip.Tip="{loc:Str Settings.RemoveFromIndexFilesStay}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveRootCommand}" CommandParameter="{Binding}">
                                            <ic:SymbolIcon Symbol="Delete" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                        <CheckBox Content="{loc:Str Settings.Hidden}" IsChecked="{Binding IncludeHidden, Mode=TwoWay}" />
                                        <CheckBox Content="{loc:Str Settings.System}" IsChecked="{Binding IncludeSystem, Mode=TwoWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{loc:Str Settings.Depth}" VerticalAlignment="Center" />
                                            <TextBox AutomationProperties.Name="{loc:Str Settings.Depth}" Text="{Binding DepthText, Mode=TwoWay}" PlaceholderText="{loc:Str Settings.All}" Width="70" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ui:FASettingsExpander.ItemTemplate>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Exclusions}" Description="{loc:Str Settings.WhatStaysOutOfTheIndex}" IsExpanded="True">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Filter" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Settings.Default}" Command="{Binding ResetExclusionsCommand}" />
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem AutomationProperties.Name="{loc:Str Settings.Exclusions}">
                            <StackPanel Spacing="6">
                                <ItemsControl ItemsSource="{Binding Exclusions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExclusionItem">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                                                <Button AutomationProperties.Name="{loc:Str Settings.RemoveRule}" Grid.Column="1" Classes="tool" ToolTip.Tip="{loc:Str Settings.RemoveRule}"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveExclusionCommand}" CommandParameter="{Binding}">
                                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox AutomationProperties.Name="{loc:Str A11y.NewExclusionRule}" x:Name="NewExclusionBox" PlaceholderText="{loc:Str Settings.ForExampleBinOrTmp}" Text="{Binding NewExclusion, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="{loc:Str Settings.Add}" Command="{Binding AddExclusionCommand}" />
                                </Grid>
                                <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding ExclusionPreview}" IsVisible="{Binding HasExclusionPreview}" />
                                <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Text="{Binding ExclusionError}" IsVisible="{Binding HasExclusionError}" />
                            </StackPanel>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.NewRoots}" Description="{loc:Str Settings.WhatToIndexInFoldersAnd}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="NewFolder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.HiddenFilesAndFolders}">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch AutomationProperties.Name="{loc:Str Settings.HiddenFilesAndFolders}" IsChecked="{Binding IncludeHiddenByDefault, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.SystemFilesAndFolders}">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch AutomationProperties.Name="{loc:Str Settings.SystemFilesAndFolders}" IsChecked="{Binding IncludeSystemByDefault, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.EnterJunctionsAndSymbolicLinksProtected}">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch AutomationProperties.Name="{loc:Str Settings.EnterJunctionsAndSymbolicLinksProtected}" IsChecked="{Binding FollowReparsePoints, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.DiskReconciliation}" Description="{loc:Str Settings.TheWatcherCatchesChangesReconciliationFinds}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Sync" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.DiskReconciliation}" ItemsSource="{Binding ReconcileIntervals}" SelectedItem="{Binding SelectedReconcileInterval, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Поведение -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=behavior}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Behavior}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.StartWithWindows}" Description="{loc:Str Settings.MinimizedToTheTraySoThe}"
                                           IsExpanded="{Binding HasAutoStartNote}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Play" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.StartWithWindows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsEnabled="{Binding IsAutoStartSupported}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem AutomationProperties.Name="{Binding AutoStartNote}" IsVisible="{Binding HasAutoStartNote}">
                            <TextBlock Text="{Binding AutoStartNote}" TextWrapping="Wrap" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.StartMinimized}" Description="{loc:Str Settings.WhenStartingWithWindowsTheMain}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Remove" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.StartMinimized}" IsChecked="{Binding StartMinimized, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.CloseTheMainWindowToThe}" Description="{loc:Str Settings.TheCloseButtonHidesTheWindow}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Dismiss" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.CloseTheMainWindowToThe}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.AskOnExitWhileOperationsRun}" Description="{loc:Str Settings.IfCopyingOrMovingIsIn}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Help" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.AskOnExitWhileOperationsRun}" IsChecked="{Binding ConfirmExitDuringOperations, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Интеграции -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=integrations}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Integrations}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.SendToDiskApp}" Description="{loc:Str Settings.AShortcutInTheSendTo}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Send" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.SendToDiskApp}" IsChecked="{Binding SendToEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.ContextMenu}" Description="{loc:Str Settings.AddToDiskAppForFilesOpen}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="List" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.ContextMenu}" IsChecked="{Binding ContextMenuEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.DiskappLinks}" Description="{loc:Str Settings.ADiskappSearchQLinkOpens}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Link" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.DiskappLinks}" IsChecked="{Binding ProtocolEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.DesktopShortcut}" Description="{loc:Str Settings.ADiskAppIconOnTheDesktop}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Home" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.DesktopShortcut}" IsChecked="{Binding DesktopShortcutEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Quick Switch" Description="{Binding QuickSwitchDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Folder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="Quick Switch" IsChecked="{Binding QuickSwitchEnabled, Mode=TwoWay}" IsEnabled="{Binding IsQuickSwitchSupported}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <TextBlock Margin="16,-2,16,6" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Text="{Binding IntegrationNote}" IsVisible="{Binding HasIntegrationNote}" />
                </StackPanel>

                <!-- Входящие -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=inbox}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Inbox}" />
                    <!-- Основная папка-накопитель (этап 18.2): в неё слилась прежняя папка «Входящие» -->
                    <ui:FASettingsExpander Header="{loc:Str Settings.MainInbox}" Description="{loc:Str Settings.MainInboxDescription}" IsExpanded="{Binding !HasInboxes}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Download" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <ComboBox AutomationProperties.Name="{loc:Str Settings.MainInbox}" ItemsSource="{Binding MainInboxOptions}" SelectedItem="{Binding SelectedMainInbox, Mode=TwoWay}"
                                          MinWidth="220" IsVisible="{Binding HasInboxes}" />
                                <!-- С накопителями кнопка не нужна: она есть у «Рабочих папок» и занимала место заголовка -->
                                <Button Content="{loc:Str Settings.OpenSorting}" Command="{Binding OpenSortingCommand}" IsVisible="{Binding !HasInboxes}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem AutomationProperties.Name="{loc:Str Settings.NoInboxesYet}" IsVisible="{Binding !HasInboxes}">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Str Settings.NoInboxesYet}" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <!-- Очередь накопителей (этап 17.1): редкие настройки — свёрнуты -->
                    <ui:FASettingsExpander Header="{loc:Str Settings.InboxQueue}" Description="{loc:Str Settings.InboxQueueDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.SettleSeconds}" Description="{loc:Str Settings.SettleSecondsDescription}">
                            <ui:FASettingsExpanderItem.Footer>
                                <NumericUpDown AutomationProperties.Name="{loc:Str Settings.SettleSeconds}" Value="{Binding SettleSeconds, Mode=TwoWay}" Minimum="0" Maximum="600" Increment="1" FormatString="0" MinWidth="150" />
                            </ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem>
                            <!-- Шаблоны — длинная строка: поле во всю ширину под подписью, а не справа -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Str Settings.IgnorePatterns}" />
                                <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{loc:Str Settings.IgnorePatternsDescription}" />
                                <TextBox AutomationProperties.Name="{loc:Str Settings.IgnorePatterns}" Text="{Binding IgnorePatternsText, Mode=TwoWay}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.FileNameFromTheClipboard}" Description="{loc:Str Settings.CtrlShiftVSavesTextOr}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Paste" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <TextBox AutomationProperties.Name="{loc:Str Settings.FileNameFromTheClipboard}" Text="{Binding ClipboardNameTemplate, Mode=TwoWay}" MinWidth="240" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <!-- Рабочие папки (этап 17.2): настраиваются в карточке на странице «Разбор» -->
                    <ui:FASettingsExpander Header="{loc:Str Settings.WorkFolders}" Description="{loc:Str Settings.WorkFoldersDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Folder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Settings.OpenSorting}" Command="{Binding OpenSortingCommand}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Уведомления (этап 21.5) -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=notifications}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Notifications}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.DoNotDisturb}" Description="{Binding DoNotDisturbText}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Content="{loc:Str Settings.DoNotDisturbForHour}" Command="{Binding DoNotDisturbForHourCommand}" />
                                <Button Content="{loc:Str Settings.DoNotDisturbUntilTomorrow}" Command="{Binding DoNotDisturbUntilTomorrowCommand}" />
                                <Button Content="{loc:Str Settings.DoNotDisturbTurnOff}" Command="{Binding DoNotDisturbOffCommand}" IsVisible="{Binding IsDoNotDisturbOn}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.NotificationKinds}" Description="{loc:Str Settings.NotificationKindsDescription}" IsExpanded="False">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="List" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.NotifyAutoSort}">
                            <ui:FASettingsExpanderItem.Footer>
                                <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.NotifyAutoSort}" IsChecked="{Binding NotifyAutoSort, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                            </ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.NotifySortingReminders}">
                            <ui:FASettingsExpanderItem.Footer>
                                <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.NotifySortingReminders}" IsChecked="{Binding NotifySortingReminders, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                            </ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.NotifyOperations}">
                            <ui:FASettingsExpanderItem.Footer>
                                <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.NotifyOperations}" IsChecked="{Binding NotifyOperations, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                            </ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="{loc:Str Settings.NotifyIndex}">
                            <ui:FASettingsExpanderItem.Footer>
                                <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.NotifyIndex}" IsChecked="{Binding NotifyIndex, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                            </ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.NotificationPersistence}" Description="{loc:Str Settings.NotificationPersistenceDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Sync" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox AutomationProperties.Name="{loc:Str Settings.NotificationPersistence}" ItemsSource="{Binding Persistences}" SelectedItem="{Binding SelectedPersistence, Mode=TwoWay}" MinWidth="150" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.QuietHours}" Description="{loc:Str Settings.QuietHoursDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <TimePicker AutomationProperties.Name="{loc:Str Settings.QuietFrom}" ToolTip.Tip="{loc:Str Settings.QuietFrom}" ClockIdentifier="24HourClock" MinuteIncrement="15" SelectedTime="{Binding QuietFrom, Mode=TwoWay}" IsEnabled="{Binding QuietHoursEnabled}" />
                                <TimePicker AutomationProperties.Name="{loc:Str Settings.QuietTo}" ToolTip.Tip="{loc:Str Settings.QuietTo}" ClockIdentifier="24HourClock" MinuteIncrement="15" SelectedTime="{Binding QuietTo, Mode=TwoWay}" IsEnabled="{Binding QuietHoursEnabled}" />
                                <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.QuietHours}" IsChecked="{Binding QuietHoursEnabled, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.RespectWindowsDoNotDisturb}" Description="{loc:Str Settings.RespectWindowsDoNotDisturbDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Settings" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch AutomationProperties.Name="{loc:Str Settings.RespectWindowsDoNotDisturb}" IsChecked="{Binding RespectWindowsDoNotDisturb, Mode=TwoWay}" OnContent="{loc:Str Common.On}" OffContent="{loc:Str Common.Off}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Данные -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=data}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Data}" />
                    <ui:FASettingsExpander Header="{loc:Str Settings.DataFolder}" Description="{Binding DataDirectoryText}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Folder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Common.Open}" Command="{Binding OpenDataFolderCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Index}" Description="{Binding IndexSizeText}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Library" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Settings.Rebuild2}" Command="{Binding RebuildIndexCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.FileHistory}" Description="{loc:Str Settings.FileHistoryDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <NumericUpDown AutomationProperties.Name="{loc:Str Settings.FileHistoryDays}" Value="{Binding FileHistoryRetentionDays, Mode=TwoWay}" Minimum="1" Maximum="3650" Increment="30" FormatString="0" MinWidth="150" ToolTip.Tip="{loc:Str Settings.FileHistoryDays}" />
                                <NumericUpDown AutomationProperties.Name="{loc:Str Settings.FileHistoryMegabytes}" Value="{Binding FileHistoryMaxSizeMegabytes, Mode=TwoWay}" Minimum="1" Maximum="1024" Increment="10" FormatString="0" MinWidth="150" ToolTip.Tip="{loc:Str Settings.FileHistoryMegabytes}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.IconAndThumbnailCache}" Description="{Binding CacheSizeText}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Pictures" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Settings.Clear2}" Command="{Binding ClearCacheCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.SettingsTransfer}" Description="{loc:Str Settings.SaveSettingsToAJSONFile}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Save" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Content="{loc:Str Settings.SaveToFile}" Command="{Binding ExportSettingsCommand}" />
                                <Button Content="{loc:Str Settings.Load}" Command="{Binding ImportSettingsCommand}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Log}" Description="{loc:Str Settings.HowDetailedTheLogFileIs}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Document" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <ComboBox AutomationProperties.Name="{loc:Str Settings.Log}" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" MinWidth="220" />
                                <Button Content="{loc:Str Settings.OpenFolder}" Command="{Binding OpenLogsFolderCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.DiagnosticArchive}" Description="{loc:Str Settings.DiagnosticArchiveDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Send" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Settings.Collect}" Command="{Binding CreateDiagnosticArchiveCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.ResetSettings}" Description="{loc:Str Settings.ResetSettingsDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Undo" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Settings.ResetEllipsis}" Command="{Binding ResetSettingsCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Backups}" Description="{loc:Str Settings.ScheduleStorageLocationsAndRestoreWill}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Sync" /></ui:FASettingsExpander.IconSource>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Журнал (этап 9.5): хвост текущего файла журнала с фильтром по уровню -->
                <StackPanel Spacing="8" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=logs}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.Logs}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Str Logs.Description}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <ComboBox AutomationProperties.Name="{loc:Str Logs.Level}" MinWidth="220" ItemsSource="{Binding LogFilters}" SelectedItem="{Binding SelectedLogFilter, Mode=TwoWay}" />
                        <Button Content="{loc:Str Logs.Refresh}" Command="{Binding RefreshLogsCommand}" />
                        <Button Content="{loc:Str Settings.OpenFolder}" Command="{Binding OpenLogsFolderCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                        <Button Content="{loc:Str Error.CreateArchive}" Command="{Binding CreateDiagnosticArchiveCommand}" IsEnabled="{Binding IsMaintenanceSupported}" />
                    </WrapPanel>
                    <TextBlock Classes="tertiary" FontSize="12" Text="{Binding LogsText}" />
                    <Border Classes="card" Padding="4">
                        <ListBox AutomationProperties.Name="{loc:Str Settings.Logs}" Height="460" Background="Transparent" ItemsSource="{Binding LogLines}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="text:LogLine">
                                    <TextBlock Classes="code-log"
                                               Classes.warning="{Binding IsWarning}"
                                               Classes.error="{Binding IsError}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Text}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <!-- О программе -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=about}">
                    <TextBlock Classes="section" Text="{loc:Str Settings.About}" />
                    <ui:FASettingsExpander Header="DiskApp" Description="{Binding VersionText}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Help" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <WrapPanel ItemSpacing="8" LineSpacing="8">
                                <Button Content="{loc:Str WhatsNew.Show}" Command="{Binding ShowWhatsNewCommand}" />
                                <HyperlinkButton Content="{loc:Str Settings.RepositoryOnGitHub}" NavigateUri="{Binding RepositoryUri}" />
                            </WrapPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Onboarding}" Description="{loc:Str Settings.OnboardingDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Star" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="{loc:Str Settings.OnboardingRun}" Command="{Binding RestartOnboardingCommand}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.Updates}" Description="{Binding UpdatesText}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Download" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <HyperlinkButton Content="{loc:Str Settings.Releases}" NavigateUri="{Binding ReleasesUri}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.ReportAProblem}" Description="{loc:Str Settings.DescribeWhatHappenedTheLogIs}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Alert" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <HyperlinkButton Content="{loc:Str Settings.IssuesOnGitHub}" NavigateUri="{Binding IssuesUri}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="{loc:Str Settings.ThirdPartyComponents}" Description="{loc:Str Settings.OpenSourceLibrariesInThisBuild}" ItemsSource="{Binding ThirdParty}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Library" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="svc:ThirdPartyComponent">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Name}" />
                                        <Run Text="{Binding Version}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </TextBlock>
                                    <HyperlinkButton Grid.Column="1" Content="{loc:Str Settings.PackageAndLicense}" NavigateUri="{Binding Link}" />
                                </Grid>
                            </DataTemplate>
                        </ui:FASettingsExpander.ItemTemplate>
                    </ui:FASettingsExpander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
