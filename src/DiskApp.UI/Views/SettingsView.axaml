<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="900"
             x:Class="DiskApp.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Design.DataContext="{x:Static vm:DesignData.Settings}">
    <!-- Настройки в стиле «Параметров» Windows 11 (PLAN.md, этап 9.1): разделы слева, SettingsExpander справа.
         Каждое изменение сохраняется сразу и применяется без перезапуска; отклонённое значение возвращается с пояснением. -->
    <Grid Margin="16,12,16,8" RowDefinitions="Auto,*" ColumnDefinitions="220,*">
        <TextBlock Grid.ColumnSpan="2" Theme="{StaticResource TitleLargeTextBlockStyle}" Text="Настройки" Margin="0,0,0,12" />

        <ListBox x:Name="CategoriesList" Grid.Row="1" Classes="settings-nav" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsCategory">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                        <ui:FASymbolIcon Symbol="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <StackPanel Spacing="4" MaxWidth="{StaticResource PageMaxWidth}" Margin="0,0,12,16">
                <ui:FAInfoBar IsOpen="{Binding HasSettingsNote}" IsClosable="False" Severity="Warning" Title="Настройки" Message="{Binding SettingsNote}" Margin="0,0,0,8" />

                <!-- Внешний вид -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=appearance}">
                    <TextBlock Classes="section" Text="Внешний вид" />
                    <ui:FASettingsExpander Header="Тема" Description="Светлая, тёмная или как в системе">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="DarkTheme" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Фон окон" Description="Mica в главном окне и Acrylic в окне поиска или сплошной цвет темы">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="ColorBackground" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox ItemsSource="{Binding Backdrops}" SelectedItem="{Binding SelectedBackdrop, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Акцентный цвет" Description="Цвет Windows или свой: кнопки, выделение, подсветка совпадений" IsExpanded="{Binding !UseSystemAccent}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="ColorFill" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding UseSystemAccent, Mode=TwoWay}" OnContent="Как в Windows" OffContent="Свой" />
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem Content="Свой цвет" IsEnabled="{Binding !UseSystemAccent}">
                            <ui:FASettingsExpanderItem.Footer>
                                <ItemsControl ItemsSource="{Binding AccentChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AccentChoice">
                                            <Button Classes="swatch" ToolTip.Tip="{Binding Color}"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectAccentCommand}" CommandParameter="{Binding}">
                                                <Panel>
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="{Binding Color}" />
                                                    <ic:SymbolIcon Symbol="Checkmark" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsSelected}" />
                                                </Panel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Масштаб" Description="Размер текста и элементов главного окна и окна поиска">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="FontSize" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox ItemsSource="{Binding FontScales}" SelectedItem="{Binding SelectedFontScale, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Компактные списки" Description="Строки результатов ниже — на экране помещается больше файлов">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="List" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Compact, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Уменьшить движение" Description="Без анимаций появления окон и переходов; также включается системной настройкой Windows">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Pause" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding ReduceMotion, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Быстрый поиск -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=quick}">
                    <TextBlock Classes="section" Text="Быстрый поиск" />
                    <ui:FASettingsExpander Header="Горячая клавиша"
                                           Description="Показать или скрыть окно быстрого поиска из любого приложения"
                                           IsExpanded="{Binding Hotkeys.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Keyboard" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Border Classes="chip" Padding="10,4">
                                <TextBlock Text="{Binding Hotkeys.QuickSearchText}" FontSize="13" />
                            </Border>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem IsVisible="{Binding Hotkeys.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Hotkeys.Message}" TextWrapping="Wrap" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Разбор входящих" Description="Сессия разбора «Загрузок» — появится на этапе 17">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Download" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Border Classes="chip" Padding="10,4">
                                <TextBlock Text="{Binding InboxHotkeyText}" FontSize="13" />
                            </Border>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Монитор" Description="Где показывать окно быстрого поиска">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="DockLeft" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox ItemsSource="{Binding PopupMonitors}" SelectedItem="{Binding SelectedPopupMonitor, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Прятать при потере фокуса" Description="Щелчок в другом окне закрывает поиск; иначе — только Esc и горячая клавиша">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="View" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding HideOnDeactivate, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Подробности в строках" Description="Что показывать рядом с именем файла" IsExpanded="True">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Document" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpanderItem Content="Папка">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowPath, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="Размер">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowSize, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="Дата изменения">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding ShowDate, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Клавиши окна поиска" Description="Что делают клавиши, пока открыто окно быстрого поиска" ItemsSource="{Binding KeyMap}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Keyboard" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeyMapEntry">
                                <Grid ColumnDefinitions="180,*">
                                    <Border Classes="chip" HorizontalAlignment="Left" Padding="8,2">
                                        <TextBlock Text="{Binding Keys}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ui:FASettingsExpander.ItemTemplate>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Поиск -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=search}">
                    <TextBlock Classes="section" Text="Поиск" />
                    <ui:FASettingsExpander Header="Нечёткий поиск" Description="Если точных совпадений мало, находить имена с опечаткой: «reprot» → «report»">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Find" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Fuzzy, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Подборка при пустом запросе" Description="Недавно открытые, закреплённые и изменённые файлы, пока ничего не введено">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding ShowSuggestionsOnEmpty, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Порядок результатов" Description="Что важнее: совпадение имени, свежесть или баланс с частотой открытия">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Sort" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox ItemsSource="{Binding RankingPresets}" SelectedItem="{Binding SelectedRankingPreset, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Кандидатов до ранжирования" Description="Больше — точнее порядок на огромных индексах, но медленнее; 2 000 держит ответ в пределах 50 мс">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Filter" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <NumericUpDown Value="{Binding CandidateLimit, Mode=TwoWay}" Minimum="100" Maximum="5000" Increment="100" FormatString="0" MinWidth="150" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="История запросов" Description="Сколько запросов помнить для подсказок по ↑; 0 — не запоминать">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Clock" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumericUpDown Value="{Binding HistoryLimit, Mode=TwoWay}" Minimum="0" Maximum="1000" Increment="10" FormatString="0" MinWidth="150" />
                                <Button Content="Очистить…" Command="{Binding ClearHistoryCommand}" />
                            </StackPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Индекс -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=index}">
                    <TextBlock Classes="section" Text="Индекс" />
                    <ui:FASettingsExpander Header="Корни" Description="Папки и диски, по которым идёт поиск" IsExpanded="True" ItemsSource="{Binding RootItems}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Folder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Добавить папку…" Command="{Binding AddRootFolderCommand}" />
                                <Button Content="Диск">
                                    <Button.Flyout>
                                        <Flyout>
                                            <ItemsControl ItemsSource="{Binding Drives}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding}"
                                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).AddDriveCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="vm:RootSettingsItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                    <ic:SymbolIcon Grid.RowSpan="2" Symbol="Folder" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Root.Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="tertiary" FontSize="12" Text="{Binding StateText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="tool" ToolTip.Tip="Пересканировать"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RescanRootCommand}" CommandParameter="{Binding}">
                                            <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
                                        </Button>
                                        <Button Classes="tool" ToolTip.Tip="Убрать из индекса (файлы останутся)"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveRootCommand}" CommandParameter="{Binding}">
                                            <ic:SymbolIcon Symbol="Delete" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                                        <CheckBox Content="Скрытые" IsChecked="{Binding IncludeHidden, Mode=TwoWay}" />
                                        <CheckBox Content="Системные" IsChecked="{Binding IncludeSystem, Mode=TwoWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Глубина" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding DepthText, Mode=TwoWay}" PlaceholderText="все" Width="70" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ui:FASettingsExpander.ItemTemplate>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Исключения" Description="Что не попадает в индекс: шаблоны путей, где ** — любые папки, * — любая часть имени" IsExpanded="True">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Filter" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <Button Content="По умолчанию" Command="{Binding ResetExclusionsCommand}" />
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem>
                            <StackPanel Spacing="6">
                                <ItemsControl ItemsSource="{Binding Exclusions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExclusionItem">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                                                <Button Grid.Column="1" Classes="tool" ToolTip.Tip="Убрать правило"
                                                        Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveExclusionCommand}" CommandParameter="{Binding}">
                                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="NewExclusionBox" PlaceholderText="Например, **/bin/** или *.tmp" Text="{Binding NewExclusion, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="Добавить" Command="{Binding AddExclusionCommand}" />
                                </Grid>
                                <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Text="{Binding ExclusionError}" IsVisible="{Binding HasExclusionError}" />
                            </StackPanel>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Новые корни" Description="Что индексировать у добавляемых папок и дисков">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="NewFolder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpanderItem Content="Скрытые файлы и папки">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding IncludeHiddenByDefault, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="Системные файлы и папки">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding IncludeSystemByDefault, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                        <ui:FASettingsExpanderItem Content="Заходить в junction и символические ссылки (с защитой от циклов)">
                            <ui:FASettingsExpanderItem.Footer><ToggleSwitch IsChecked="{Binding FollowReparsePoints, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" /></ui:FASettingsExpanderItem.Footer>
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Сверка с диском" Description="Изменения ловит наблюдатель; сверка находит пропущенное, например после работы без DiskApp">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Sync" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox ItemsSource="{Binding ReconcileIntervals}" SelectedItem="{Binding SelectedReconcileInterval, Mode=TwoWay}" MinWidth="190" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Поведение -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=behavior}">
                    <TextBlock Classes="section" Text="Поведение" />
                    <ui:FASettingsExpander Header="Запускать вместе с Windows" Description="Свёрнутым в трей, чтобы горячая клавиша работала сразу после входа"
                                           IsExpanded="{Binding HasAutoStartNote}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Play" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsEnabled="{Binding IsAutoStartSupported}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem IsVisible="{Binding HasAutoStartNote}">
                            <TextBlock Text="{Binding AutoStartNote}" TextWrapping="Wrap" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Запускаться свёрнутым" Description="При запуске вместе с Windows главное окно не показывается — только значок в трее">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Remove" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Закрывать главное окно в трей" Description="Крестик прячет окно; выход — из меню трея">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Dismiss" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Спрашивать при выходе во время операций" Description="Если идёт копирование или перемещение, выход сначала спросит">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Help" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding ConfirmExitDuringOperations, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Интеграции -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=integrations}">
                    <TextBlock Classes="section" Text="Интеграции" />
                    <ui:FASettingsExpander Header="«Отправить» → DiskApp" Description="Ярлык в меню «Отправить»: выбранные файлы кладутся в папку, которую вы выберете">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Send" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding SendToEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Контекстное меню" Description="«Добавить в DiskApp» для файлов, «Открыть в DiskApp» и «Добавить в индекс» для папок">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="List" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding ContextMenuEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Ссылки diskapp://" Description="Ссылка diskapp://search?q=… открывает поиск с запросом">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Link" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding ProtocolEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Ярлык на рабочем столе" Description="Значок DiskApp на рабочем столе открывает главное окно">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Home" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding DesktopShortcutEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIntegrationSupported}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Quick Switch" Description="{Binding QuickSwitchDescription}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Folder" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding QuickSwitchEnabled, Mode=TwoWay}" IsEnabled="{Binding IsQuickSwitchSupported}" OnContent="Вкл" OffContent="Выкл" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <TextBlock Margin="16,-2,16,6" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Text="{Binding IntegrationNote}" IsVisible="{Binding HasIntegrationNote}" />
                </StackPanel>

                <!-- Входящие -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=inbox}">
                    <TextBlock Classes="section" Text="Входящие" />
                    <ui:FASettingsExpander Header="Папка «Входящие»" Description="Куда по умолчанию кладётся добавленное: перетаскивание на главную, «Отправить», буфер обмена" IsExpanded="True">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Download" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Выбрать…" Command="{Binding PickInboxCommand}" />
                                <Button Content="Первый корень" Command="{Binding ResetInboxCommand}" />
                            </StackPanel>
                        </ui:FASettingsExpander.Footer>
                        <ui:FASettingsExpanderItem>
                            <TextBlock TextWrapping="Wrap" Text="{Binding InboxText}" />
                        </ui:FASettingsExpanderItem>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Имя файла из буфера обмена" Description="Ctrl+Shift+V сохраняет текст или картинку в файл с таким именем: {date}, {time}, {title}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Paste" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <TextBox Text="{Binding ClipboardNameTemplate, Mode=TwoWay}" MinWidth="240" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                    <ui:FASettingsExpander Header="Разбор папок-накопителей" Description="Напоминания, «не беспокоить», правила автосортировки и журнал решений появятся вместе с разбором входящих (этап 17)">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Alert" /></ui:FASettingsExpander.IconSource>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- Данные -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=data}">
                    <TextBlock Classes="section" Text="Данные" />
                    <ui:FASettingsExpander Header="Журнал" Description="Подробность файла журнала; меняется сразу">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Document" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" MinWidth="220" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>

                <!-- О программе -->
                <StackPanel Spacing="4" IsVisible="{Binding SelectedCategory.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=about}">
                    <TextBlock Classes="section" Text="О программе" />
                    <ui:FASettingsExpander Header="DiskApp" Description="{Binding VersionText}">
                        <ui:FASettingsExpander.IconSource><ui:FASymbolIconSource Symbol="Help" /></ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <HyperlinkButton Content="Репозиторий на GitHub" NavigateUri="{Binding RepositoryUri}" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
