<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="DiskApp.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Design.DataContext="{x:Static vm:DesignData.Home}">
    <!-- Главная: приветствие и состояние индекса, быстрые действия, корни индекса с действиями и добавлением папок
         (кнопкой или перетаскиванием папки на страницу), недавние, закреплённые и изменённые за сутки файлы,
         входящие, подсказка по клавишам. -->
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PagePadding}" Spacing="16" MaxWidth="{StaticResource PageMaxWidth}">

            <StackPanel Spacing="4">
                <TextBlock Theme="{StaticResource TitleLargeTextBlockStyle}" Text="{Binding Greeting}" />
                <TextBlock Classes="secondary" Text="{Binding IndexStatusText}" />
                <ProgressBar IsVisible="{Binding IsIndexing}"
                             Value="{Binding IndexProgressPercent}"
                             IsIndeterminate="{Binding IsIndexProgressIndeterminate}"
                             Maximum="100"
                             Margin="0,8,0,0" />
            </StackPanel>

            <!-- Быстрые действия -->
            <Grid ColumnDefinitions="*,16,*,16,*">
                <Button Grid.Column="0" Classes="card" Command="{Binding OpenQuickSearchCommand}">
                    <StackPanel Spacing="8">
                        <ic:SymbolIcon Symbol="Search" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                        <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="Быстрый поиск" />
                        <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding Hotkeys.QuickSearchText, StringFormat='{}{0}, три буквы и Enter — файл открыт'}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="card" Command="{Binding OpenBrowseCommand}">
                    <StackPanel Spacing="8">
                        <ic:SymbolIcon Symbol="FolderOpen" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                        <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="Обзор папок" />
                        <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="Корни, дерево и список — как в Проводнике, только быстрее" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Classes="card" Command="{Binding OpenInboxCommand}">
                    <StackPanel Spacing="8">
                        <ic:SymbolIcon Symbol="MailInbox" FontSize="24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                        <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="Разобрать входящие" />
                        <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding InboxText}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Корни индекса -->
            <StackPanel Spacing="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="AddRootButton" Click="OnAddRootClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="FolderAdd" FontSize="16" />
                            <TextBlock Text="Добавить папку" />
                        </StackPanel>
                    </Button>
                    <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Text="Корни индекса" />
                </DockPanel>
                <Border Classes="card" IsVisible="{Binding HasNoRoots}">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <ic:SymbolIcon Symbol="FolderAdd" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock HorizontalAlignment="Center" Text="Добавьте папку или диск, по которым искать" />
                        <TextBlock Classes="secondary" FontSize="12" HorizontalAlignment="Center" Text="Кнопкой «Добавить папку» или перетащите папку из Проводника на эту страницу" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Roots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RootCardViewModel">
                            <Border Classes="card root" Classes.problem="{Binding IsProblem}" Margin="0,0,8,8">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <ic:SymbolIcon Grid.RowSpan="2"
                                                   Symbol="{Binding Symbol}"
                                                   FontSize="28"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Theme="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{Binding Info.Label}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="tertiary" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Info.Path}" ToolTip.Tip="{Binding Info.Path}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="state" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Text="{Binding StateText}" />
                                    <ProgressBar Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,-4" IsIndeterminate="True" IsVisible="{Binding IsScanning}" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2" Margin="0,6,0,0">
                                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding SummaryText}" IsVisible="{Binding SummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Classes="secondary" FontSize="12" Text="{Binding LastScanText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                                        <Button Command="{Binding RescanCommand}" ToolTip.Tip="Полное сканирование заново">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="14" />
                                                <TextBlock Text="Пересканировать" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding TogglePauseCommand}" IsVisible="{Binding CanPause}">
                                            <TextBlock Text="{Binding PauseText}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid ColumnDefinitions="3*,16,2*">
                <StackPanel Grid.Column="0" Spacing="16">
                <!-- Недавние файлы -->
                <Border Classes="card" Padding="12">
                    <StackPanel Spacing="8">
                        <DockPanel Margin="4,0,4,0">
                            <Button DockPanel.Dock="Right"
                                    Theme="{StaticResource TransparentButton}"
                                    Content="Открыть поиск"
                                    Command="{Binding OpenQuickSearchCommand}" />
                            <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="Недавние файлы" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox x:Name="RecentList"
                                 Classes="results files"
                                 ItemsSource="{Binding RecentFiles}"
                                 ItemTemplate="{StaticResource FileHitTemplate}"
                                 SelectionMode="Single" />
                        <TextBlock Classes="tertiary"
                                   FontSize="12"
                                   Margin="4,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding LastOpenedText}"
                                   IsVisible="{Binding LastOpenedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- Закреплённые -->
                <Border Classes="card" Padding="12" IsVisible="{Binding HasPinned}">
                    <StackPanel Spacing="8">
                        <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0" Text="Закреплённые" />
                        <ListBox Classes="results files"
                                 ItemsSource="{Binding PinnedFiles}"
                                 ItemTemplate="{StaticResource FileHitTemplate}"
                                 SelectionMode="Single" />
                    </StackPanel>
                </Border>

                <!-- Изменённые за сутки -->
                <Border Classes="card" Padding="12" IsVisible="{Binding HasChangedToday}">
                    <StackPanel Spacing="8">
                        <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0" Text="Изменённые за сутки" />
                        <ListBox Classes="results files"
                                 ItemsSource="{Binding ChangedToday}"
                                 ItemTemplate="{StaticResource FileHitTemplate}"
                                 SelectionMode="Single" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="16">
                    <!-- Входящие -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ic:SymbolIcon Symbol="MailInbox" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="Входящие" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding InboxText}" TextWrapping="Wrap" />
                            <TextBlock Classes="secondary"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="Подсказка «куда положить», одна клавиша — следующий файл, любое решение можно отменить. Напоминание в 18:00." />
                            <Button Classes="accent"
                                    Content="Разобрать"
                                    Command="{Binding OpenInboxCommand}"
                                    IsEnabled="{Binding HasInbox}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Клавиши -->
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ic:SymbolIcon Symbol="Keyboard" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="Клавиши" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto">
                                <Border Grid.Row="0" Grid.Column="0" Classes="chip"><TextBlock Text="{Binding Hotkeys.QuickSearchText}" /></Border>
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="быстрый поиск из любого места" />
                                <Border Grid.Row="2" Grid.Column="0" Classes="chip"><TextBlock Text="↑ ↓  Enter" /></Border>
                                <TextBlock Grid.Row="2" Grid.Column="2" Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="выбрать и открыть" />
                                <Border Grid.Row="4" Grid.Column="0" Classes="chip"><TextBlock Text="Ctrl + Enter" /></Border>
                                <TextBlock Grid.Row="4" Grid.Column="2" Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="показать в Проводнике" />
                                <Border Grid.Row="6" Grid.Column="0" Classes="chip"><TextBlock Text="Ctrl + 1…9" /></Border>
                                <TextBlock Grid.Row="6" Grid.Column="2" Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="открыть результат по номеру" />
                                <Border Grid.Row="8" Grid.Column="0" Classes="chip"><TextBlock Text="Esc" /></Border>
                                <TextBlock Grid.Row="8" Grid.Column="2" Classes="secondary" FontSize="12" VerticalAlignment="Center" Text="очистить запрос, затем закрыть" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
