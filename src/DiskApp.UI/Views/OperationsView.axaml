<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             xmlns:views="using:DiskApp.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="DiskApp.UI.Views.OperationsView"
             x:DataType="vm:OperationsViewModel">
    <!-- Страница «История» (PLAN.md, этапы 8.4 и 20.4): сверху — очередь операций с ходом, отменой и возвратом результата
         (Ctrl+Z — последней); ниже — лента истории файлов по дням: что, когда и кто сделал (DiskApp, разбор, авторазбор,
         Проводник, сверка), с отбором и поиском по имени, «Вернуть на место» и «Восстановить». -->
    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*" MaxWidth="{StaticResource PageMaxWidth}">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Theme="{StaticResource TitleLargeTextBlockStyle}" Text="{loc:Str FileHistory.Page}" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Str FileHistory.PageDescription}" />
        </StackPanel>

        <!-- Без истории файлов (превью) и без операций — прежнее пустое состояние -->
        <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsEmpty" />
                    <Binding Path="!HasHistory" />
                </MultiBinding>
            </StackPanel.IsVisible>
            <ic:SymbolIcon Symbol="ArrowSync" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Classes="secondary" HorizontalAlignment="Center" Text="{loc:Str Operations.NoOperationsYet}" />
            <TextBlock Classes="tertiary" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Text="{loc:Str Operations.CopyingAndMovingFromBrowseRenaming}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- Операции: идущие и недавние -->
                <StackPanel Spacing="8" IsVisible="{Binding !IsEmpty}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="{loc:Str Operations.ClearFinished}"
                                Command="{Binding ClearFinishedCommand}"
                                IsVisible="{Binding HasFinished}" />
                        <TextBlock Classes="section" VerticalAlignment="Center" Text="{loc:Str Operations.Operations}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OperationItemViewModel">
                                <Border Classes="card" Margin="0,0,0,8" Padding="14,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <ic:SymbolIcon Grid.RowSpan="3"
                                                       Symbol="{Binding Symbol}"
                                                       FontSize="24"
                                                       Margin="0,0,14,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Theme="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="secondary" FontSize="12" Classes.error="{Binding IsFailed}" TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="{Binding StateText}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding DetailText}" />
                                        </TextBlock>
                                        <ProgressBar Grid.Row="2" Grid.Column="1"
                                                     Margin="0,8,0,0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     IsVisible="{Binding ShowProgress}" />
                                        <StackPanel Grid.RowSpan="3" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button Content="{loc:Str Common.Cancel}"
                                                    Command="{Binding $parent[ItemsControl].((vm:OperationsViewModel)DataContext).CancelCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanCancel}" />
                                            <Button AutomationProperties.Name="{loc:Str Operations.RestoreAsItWas}" Command="{Binding $parent[ItemsControl].((vm:OperationsViewModel)DataContext).UndoCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanUndo}"
                                                    ToolTip.Tip="{loc:Str Operations.RestoreAsItWas}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ic:SymbolIcon Symbol="ArrowUndo" FontSize="14" />
                                                    <TextBlock Text="{loc:Str Operations.UndoResult}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Лента истории файлов -->
                <Panel IsVisible="{Binding HasHistory}">
                    <StackPanel Spacing="8" DataContext="{Binding History}" x:DataType="vm:FileHistoryFeedViewModel">
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <TextBox AutomationProperties.Name="{loc:Str FileHistory.SearchByName}"
                                     Watermark="{loc:Str FileHistory.SearchByName}"
                                     Text="{Binding SearchText}"
                                     MinWidth="260" />
                            <ComboBox AutomationProperties.Name="{loc:Str FileHistory.Filter.Folder}" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" MinWidth="160" />
                            <ComboBox AutomationProperties.Name="{loc:Str FileHistory.Filter.Kind}" ItemsSource="{x:Static vm:FileHistoryFeedViewModel.KindFilters}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" MinWidth="200" />
                            <ComboBox AutomationProperties.Name="{loc:Str FileHistory.Filter.Source}" ItemsSource="{x:Static vm:FileHistoryFeedViewModel.SourceFilters}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" MinWidth="160" />
                            <Button AutomationProperties.Name="{loc:Str FileHistory.Refresh}" ToolTip.Tip="{loc:Str FileHistory.Refresh}" Command="{Binding RefreshCommand}">
                                <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16" />
                            </Button>
                        </WrapPanel>

                        <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />

                        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding IsEmpty}">
                            <ic:SymbolIcon Symbol="History" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Text="{loc:Str FileHistory.Empty}" IsVisible="{Binding !IsFiltered}" />
                            <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" Text="{loc:Str FileHistory.NothingFound}" IsVisible="{Binding IsFiltered}" />
                            <Button HorizontalAlignment="Center" Content="{loc:Str FileHistory.ClearFilters}" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding IsFiltered}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileHistoryDayViewModel">
                                    <StackPanel Spacing="6" Margin="0,0,0,8">
                                        <TextBlock Classes="section" Text="{Binding Title}" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FileHistoryItemViewModel">
                                                    <views:FileHistoryRow Margin="0,0,0,6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button HorizontalAlignment="Center" Content="{loc:Str FileHistory.ShowMore}" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}" />
                    </StackPanel>
                </Panel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
