<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:c="using:DiskApp.UI.Controls"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             xmlns:m="using:DiskApp.UI.Models"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="DiskApp.UI.Views.DetailsPane"
             x:DataType="vm:QuickSearchViewModel"
             Design.DataContext="{x:Static vm:DesignData.QuickSearch}">
    <!-- Панель сведений о выбранном файле (PLAN.md, этап 8.1): миниатюра или иконка, свойства, теги и действия.
         Действия — те же команды, что у клавиш и контекстного меню быстрого поиска. -->
    <Panel>
        <TextBlock Classes="tertiary"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="Выберите файл в списке — здесь появятся его сведения и действия"
                   IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNull}}" />
        <ScrollViewer IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="12" DataContext="{Binding SelectedDetails}" x:DataType="m:FileDetails">
                <c:FileIcon Width="96" Height="96"
                            HorizontalAlignment="Center"
                            CornerRadius="8"
                            IconSize="80"
                            PreferThumbnail="True"
                            Entry="{Binding Entry}"
                            Symbol="{Binding Entry.Kind, Converter={x:Static c:FileKindConverters.Symbol}}"
                            FallbackBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <SelectableTextBlock Theme="{StaticResource SubtitleTextBlockStyle}"
                                     TextWrapping="Wrap"
                                     TextAlignment="Center"
                                     Text="{Binding Entry.Name}" />
                <Border Classes="chip" HorizontalAlignment="Center" IsVisible="{Binding HasAvailability}">
                    <TextBlock Text="{Binding Availability}" />
                </Border>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Classes="details">
                    <TextBlock Grid.Row="0" Classes="label" Text="Вид" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding KindText}" />
                    <TextBlock Grid.Row="1" Classes="label" Text="Размер" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding SizeText}" />
                    <TextBlock Grid.Row="2" Classes="label" Text="Изменён" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding ModifiedText}" />
                    <TextBlock Grid.Row="3" Classes="label" Text="Корень" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Entry.Root}" />
                    <TextBlock Grid.Row="4" Classes="label" Text="Папка" />
                    <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="value" TextWrapping="Wrap" Text="{Binding Entry.Directory}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Entry.Tags}" IsVisible="{Binding HasTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Classes="chip" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="6" DataContext="{Binding $parent[UserControl].DataContext}" x:DataType="vm:QuickSearchViewModel">
                    <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding OpenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Open" FontSize="16" />
                            <TextBlock Text="Открыть" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Command="{Binding RevealCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                            <TextBlock Text="Показать в папке" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Command="{Binding CopyPathCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="DocumentCopy" FontSize="16" />
                            <TextBlock Text="Копировать путь" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Command="{Binding TogglePinCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Pin" FontSize="16" />
                            <TextBlock Text="{Binding PinMenuText}" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Command="{Binding PropertiesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Info" FontSize="16" />
                            <TextBlock Text="Свойства" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
