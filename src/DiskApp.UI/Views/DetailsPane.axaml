<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:c="using:DiskApp.UI.Controls"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             xmlns:views="using:DiskApp.UI.Views"
             xmlns:m="using:DiskApp.UI.Models"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="DiskApp.UI.Views.DetailsPane"
             x:DataType="vm:QuickSearchViewModel"
             Design.DataContext="{x:Static vm:DesignData.QuickSearch}">
    <!-- Панель сведений о выбранном файле (PLAN.md, этап 8.1): миниатюра или иконка, свойства, теги и действия.
         Действия — те же команды, что у клавиш и контекстного меню быстрого поиска. -->
    <Panel>
        <TextBlock Classes="tertiary"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{loc:Str DetailsPane.SelectAFileInTheList}"
                   IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNull}}" />
        <ScrollViewer IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="12" DataContext="{Binding SelectedDetails}" x:DataType="m:FileDetails">
                <views:FileDetailsView />

                <StackPanel Spacing="6" DataContext="{Binding $parent[UserControl].DataContext}" x:DataType="vm:QuickSearchViewModel">
                    <Button AutomationProperties.Name="{loc:Str Common.Open}" Classes="accent" HorizontalAlignment="Stretch" Command="{Binding OpenCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Open" FontSize="16" />
                            <TextBlock Text="{loc:Str Common.Open}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{loc:Str DetailsPane.ShowInFolder}" HorizontalAlignment="Stretch" Command="{Binding RevealCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                            <TextBlock Text="{loc:Str DetailsPane.ShowInFolder}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{loc:Str Common.CopyPath}" HorizontalAlignment="Stretch" Command="{Binding CopyPathCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="DocumentCopy" FontSize="16" />
                            <TextBlock Text="{loc:Str Common.CopyPath}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{Binding PinMenuText}" HorizontalAlignment="Stretch" Command="{Binding TogglePinCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Pin" FontSize="16" />
                            <TextBlock Text="{Binding PinMenuText}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{loc:Str Common.Properties}" HorizontalAlignment="Stretch" Command="{Binding PropertiesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Info" FontSize="16" />
                            <TextBlock Text="{loc:Str Common.Properties}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
