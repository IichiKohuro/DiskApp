<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             xmlns:views="using:DiskApp.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="DiskApp.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Design.DataContext="{x:Static vm:DesignData.Main}">
    <!-- Оболочка главного окна: NavigationView слева со страницами из MainViewModel, InfoBar для уведомлений,
         содержимое страницы с плавным переходом. Страницы подбираются по DataTemplates из App.axaml. -->
    <Panel>
    <ui:FANavigationView x:Name="Navigation"
                         PaneDisplayMode="Auto"
                         OpenPaneLength="236"
                         CompactModeThresholdWidth="640"
                         ExpandedModeThresholdWidth="960"
                         IsBackButtonVisible="False"
                         IsSettingsVisible="False"
                         IsPaneToggleButtonVisible="True"
                         MenuItemsSource="{Binding Pages}"
                         FooterMenuItemsSource="{Binding FooterPages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
        <ui:FANavigationView.MenuItemTemplate>
            <DataTemplate DataType="vm:PageViewModel">
                <ui:FANavigationViewItem Content="{Binding Title}">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FASymbolIconSource Symbol="{Binding Icon}" />
                    </ui:FANavigationViewItem.IconSource>
                    <ui:FANavigationViewItem.InfoBadge>
                        <ui:FAInfoBadge Value="{Binding BadgeValue}" IsVisible="{Binding HasBadge}" />
                    </ui:FANavigationViewItem.InfoBadge>
                </ui:FANavigationViewItem>
            </DataTemplate>
        </ui:FANavigationView.MenuItemTemplate>

        <ui:FANavigationView.PaneFooter>
            <!-- Состояние индекса по событиям сервера: зелёная точка — актуален, акцентная — индексация,
                 жёлтая — пауза или недоступный корень, красная — ошибка, серая — сервер запускается. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="16,8,16,8"
                        Background="Transparent"
                        AutomationProperties.Name="{Binding IndexStatusShort}"
                        ToolTip.Tip="{Binding IndexStatusDetail}">
                <Ellipse Classes="health"
                         Classes.indexing="{Binding IsHealthIndexing}"
                         Classes.warning="{Binding IsHealthWarning}"
                         Classes.error="{Binding IsHealthError}"
                         Classes.starting="{Binding IsHealthStarting}"
                         Width="8" Height="8"
                         VerticalAlignment="Center" />
                <TextBlock Classes="secondary" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding IndexStatusShort}" IsVisible="{Binding #Navigation.IsPaneOpen}" />
            </StackPanel>
        </ui:FANavigationView.PaneFooter>

        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0">
                <!-- Состояние индекса: недоступные корни и ошибки индексации -->
                <ui:FAInfoBar Margin="28,8,28,0"
                              IsOpen="{Binding IsIndexBarOpen, Mode=TwoWay}"
                              Title="{Binding IndexBarTitle}"
                              Message="{Binding IndexStatusDetail}"
                              Severity="{Binding IndexBarSeverity}"
                              IsClosable="True" />
                <!-- Идущие файловые операции: сводка и переход на страницу «Операции» -->
                <ui:FAInfoBar Margin="28,8,28,0"
                              IsOpen="{Binding Operations.HasActive}"
                              Title="{loc:Str Main.OperationsRunning}"
                              Message="{Binding Operations.Summary}"
                              Severity="Informational"
                              IsClosable="False">
                    <ui:FAInfoBar.ActionButton>
                        <Button Content="{loc:Str Main.Details}" Command="{Binding OpenOperationsCommand}" />
                    </ui:FAInfoBar.ActionButton>
                </ui:FAInfoBar>
                <ui:FAInfoBar Margin="28,8,28,0"
                              IsOpen="{Binding IsNoticeOpen, Mode=TwoWay}"
                              Title="{Binding NoticeTitle}"
                              Message="{Binding NoticeMessage}"
                              Severity="{Binding NoticeSeverity}"
                              IsClosable="True">
                    <ui:FAInfoBar.ActionButton>
                        <Button Content="{Binding NoticeActionText}" Command="{Binding RunNoticeActionCommand}" IsVisible="{Binding HasNoticeAction}" />
                    </ui:FAInfoBar.ActionButton>
                </ui:FAInfoBar>
            </StackPanel>
            <!-- Переход между страницами задаёт MainView.axaml.cs: плавный или без анимации при «уменьшить движение». -->
            <TransitioningContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding SelectedPage}" />
        </Grid>
    </ui:FANavigationView>
    <!-- Мастер первого запуска поверх всего окна (этап 9.3) -->
    <Panel IsVisible="{Binding IsOnboarding}">
        <views:OnboardingView DataContext="{Binding Onboarding}" />
    </Panel>
    </Panel>
</UserControl>
