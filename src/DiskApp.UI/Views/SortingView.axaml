<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:c="using:DiskApp.UI.Controls"
             xmlns:s="using:DiskApp.UI.Services"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="DiskApp.UI.Views.SortingView"
             x:DataType="vm:SortingViewModel">
    <!-- Страница «Разбор» (PLAN.md, этап 17): слева файлы из накопителей, справа — куда их положить: рабочая папка
         (клавиши 1–9) или любая найденная, подпапка (в том числе новая), теги; Ctrl+Enter — перенести. -->
    <UserControl.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:SortFolderNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <Style Selector="ListBox.chips > ListBoxItem">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <!-- Отложенные и оставленные здесь (этап 17.1) — бледнее новых -->
        <Style Selector="Grid.dimmed">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- Номер рабочей папки на чипе — плашка-клавиша -->
        <Style Selector="Border.keycap">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.keycap">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <!-- Кнопка «Имя» или «Теги», когда что-то задано: текст акцентом -->
        <Style Selector="Button.option.set > StackPanel > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.option.set > StackPanel > ic|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Колонки: файлы накопителей, разделитель (ширина запоминается), рабочие папки -->
    <Grid x:Name="RootGrid" Margin="16,12,16,8" RowDefinitions="Auto,*,Auto,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="380" MinWidth="280" MaxWidth="900" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <Button AutomationProperties.Name="{loc:Str Common.RefreshF5}" Classes="tool" Command="{Binding RefreshCommand}" HotKey="F5" ToolTip.Tip="{loc:Str Common.RefreshF5}">
                    <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16" />
                </Button>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Theme="{StaticResource TitleLargeTextBlockStyle}" Text="{loc:Str Sorting.Title}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Str Sorting.Description}" />
            </StackPanel>
        </DockPanel>

        <!-- Накопители и их файлы -->
        <Border Grid.Row="1" Classes="card" Padding="8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,6">
                    <Button DockPanel.Dock="Right" AutomationProperties.Name="{loc:Str Sorting.AddInbox}" Classes="tool" Command="{Binding AddInboxCommand}" ToolTip.Tip="{loc:Str Sorting.AddInbox}" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Add" FontSize="14" />
                            <TextBlock Text="{loc:Str Sorting.Inbox}" />
                        </StackPanel>
                    </Button>
                    <ListBox AutomationProperties.Name="{loc:Str Sorting.Inboxes}" Classes="chips" ItemsSource="{Binding Inboxes}" SelectedItem="{Binding SelectedInbox, Mode=TwoWay}" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:InboxFilter">
                                <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" ToolTip.Tip="{Binding Problem}">
                                    <!-- Основная папка-накопитель (этап 18.2): сюда падают файлы из окна Drag&Drop -->
                                    <ic:SymbolIcon Symbol="Star" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsMain}"
                                                   ToolTip.Tip="{loc:Str Sorting.MainInboxTip}" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="{loc:Str Sorting.MakeMainInbox}"
                                                      Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).MakeMainInboxCommand}"
                                                      CommandParameter="{Binding}"
                                                      IsVisible="{Binding CanMakeMain}" />
                                            <MenuItem Header="{loc:Str Sorting.IncludeSubfolders}" ToggleType="CheckBox"
                                                      IsChecked="{Binding Folder.IncludeSubfolders, Mode=OneWay, FallbackValue=False}"
                                                      Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).ToggleSubfoldersCommand}"
                                                      CommandParameter="{Binding}"
                                                      IsVisible="{Binding IsFolder}" />
                                            <MenuItem Header="{loc:Str Sorting.RemoveInbox}"
                                                      Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).RemoveInboxCommand}"
                                                      CommandParameter="{Binding}"
                                                      IsVisible="{Binding IsFolder}" />
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <!-- Под списком: очередь (этап 17.1) — дописываемые файлы числом, «оставленные здесь» по кнопке;
                     справа «Удалить всё» — накопитель разобран, остальное не нужно (замечание 2026-10-12) -->
                <DockPanel DockPanel.Dock="Bottom" Margin="6,6,0,0">
                    <Button DockPanel.Dock="Right" Classes="tool" Command="{Binding DeleteAllCommand}" IsVisible="{Binding CanDelete}" IsEnabled="{Binding !!Items.Count}"
                            AutomationProperties.Name="{loc:Str Sorting.DeleteAll}" ToolTip.Tip="{loc:Str Sorting.DeleteAllTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Delete" FontSize="14" />
                            <TextBlock Text="{loc:Str Sorting.DeleteAll}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Classes="tertiary" FontSize="12" VerticalAlignment="Center" Text="{Binding PendingText}" IsVisible="{Binding HasPending}" />
                        <HyperlinkButton Padding="0" FontSize="12" Content="{Binding KeptText}" Command="{Binding ToggleShowKeptCommand}" IsVisible="{Binding HasKept}" />
                    </StackPanel>
                </DockPanel>
                <Panel>
                    <ListBox x:Name="ItemsList" AutomationProperties.Name="{loc:Str Sorting.Files}" ItemsSource="{Binding Items}" SelectionMode="Multiple">
                        <ListBox.ContextFlyout>
                            <MenuFlyout>
                                <!-- Посмотреть файл, прежде чем решить, куда его положить; двойной щелчок — то же -->
                                <MenuItem Header="{loc:Str Sorting.OpenFile}" Command="{Binding OpenItemCommand}" CommandParameter="{x:Null}" IsEnabled="{Binding HasSelection}">
                                    <MenuItem.Icon>
                                        <ic:SymbolIcon Symbol="Open" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Str Sorting.RevealFile}" Command="{Binding RevealItemCommand}" CommandParameter="{x:Null}" IsEnabled="{Binding HasSelection}" IsVisible="{Binding CanReveal}">
                                    <MenuItem.Icon>
                                        <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <!-- Шаблон из решения (этап 17.5): такие файлы сами уходят в выбранное назначение -->
                                <MenuItem Header="{Binding AlwaysHereText}" Command="{Binding AlwaysHereCommand}">
                                    <MenuItem.Icon>
                                        <ic:SymbolIcon Symbol="Sparkle" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{loc:Str Sorting.Postpone}" Command="{Binding PostponeCommand}" IsEnabled="{Binding HasSelection}" />
                                <MenuItem Header="{loc:Str Sorting.KeepHere}" Command="{Binding KeepHereCommand}" IsEnabled="{Binding HasSelection}" />
                                <MenuItem Header="{loc:Str Sorting.ReturnToNew}" Command="{Binding ReturnToNewCommand}" IsVisible="{Binding SelectionHasState}" />
                                <Separator IsVisible="{Binding CanDelete}" />
                                <!-- Ненужный файл — в корзину Windows (замечание 2026-10-12) -->
                                <MenuItem Header="{loc:Str Sorting.DeleteFile}" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding HasSelection}" IsVisible="{Binding CanDelete}" InputGesture="Delete">
                                    <MenuItem.Icon>
                                        <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </ListBox.ContextFlyout>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SortItem">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3" Classes.dimmed="{Binding HasState}">
                                    <c:FileIcon Width="30" Height="30" CornerRadius="6" IconSize="22" VerticalAlignment="Center"
                                                Entry="{Binding Entry}" Symbol="{Binding Symbol}"
                                                FallbackBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Entry.Name}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="tertiary" FontSize="11" Text="{Binding Inbox.Title}" TextTrimming="CharacterEllipsis" />
                                            <!-- Состояние (этап 17.1): отложен или оставлен здесь -->
                                            <TextBlock Classes="tertiary" FontSize="11" FontStyle="Italic" Text="{Binding StateText}" IsVisible="{Binding HasState}" />
                                        </StackPanel>
                                        <!-- Подсказка шаблонов рабочих папок (этап 17.5) или истории решений (этап 17.4): куда и почему -->
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding HintText}" IsVisible="{Binding HasHint}" ToolTip.Tip="{Binding HintText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Classes="secondary" FontSize="12" HorizontalAlignment="Right" Text="{Binding ModifiedText}" />
                                        <TextBlock Classes="tertiary" FontSize="11" HorizontalAlignment="Right" Text="{Binding SizeText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding HasEmptyHint}">
                        <ic:SymbolIcon Symbol="MailInbox" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Text="{Binding EmptyHint}" />
                        <Button HorizontalAlignment="Center" Classes="accent" Content="{loc:Str Sorting.AddInbox}" Command="{Binding AddInboxCommand}" IsVisible="{Binding HasNoInboxes}" />
                    </StackPanel>
                </Panel>
            </DockPanel>
        </Border>

        <!-- Разделитель панелей: тянется мышью, ширина рабочих папок запоминается -->
        <GridSplitter x:Name="PanelsSplitter" Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Background="Transparent"
                      AutomationProperties.Name="{loc:Str Sorting.ResizePanels}" ToolTip.Tip="{loc:Str Sorting.ResizePanels}" />
        <Border Grid.Row="1" Grid.Column="1" Width="3" Height="36" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.5" />

        <!-- Куда -->
        <Border Grid.Row="1" Grid.Column="2" Classes="card" Padding="12">
            <DockPanel>
                <!-- Рабочие папки, поиск, дерево -->
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" AutomationProperties.Name="{loc:Str Sorting.AddWorkFolder}" Classes="tool" Command="{Binding AddWorkFolderCommand}" ToolTip.Tip="{loc:Str Sorting.AddWorkFolder}">
                            <ic:SymbolIcon Symbol="Add" FontSize="14" />
                        </Button>
                        <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Text="{loc:Str Sorting.WorkFolders}" />
                    </DockPanel>
                    <ListBox DockPanel.Dock="Top" AutomationProperties.Name="{loc:Str Sorting.WorkFolders}" Classes="chips" ItemsSource="{Binding WorkFolders}" SelectedItem="{Binding SelectedWorkFolder, Mode=TwoWay}" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkFolderItem">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                                    <!-- Папки нет на месте (этап 17.2): перенесена или удалена — исправить в карточке -->
                                    <ic:SymbolIcon Symbol="Warning" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsMissing}"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <!-- Клавиша 1–9 — плашкой, как клавиша: «1» не сливается с подписью «10S-417» -->
                                    <Border Classes="keycap" IsVisible="{Binding HasNumber}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NumberText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Папка проекта (этап 24): иконка с номером проекта -->
                                    <c:ProjectBadge BadgeSize="18" VerticalAlignment="Center" Number="{Binding Project.Number}" Color="{Binding Project.Color}" IsVisible="{Binding HasProject}" />
                                    <TextBlock Text="{Binding Folder.Title}" VerticalAlignment="Center" />
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="{loc:Str Sorting.EditWorkFolder}" Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).EditWorkFolderCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="{loc:Str Sorting.WorkFolderAutoTags}" Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).EditWorkFolderAutoTagsCommand}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Str Sorting.Earlier}" Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).MoveWorkFolderUpCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="{loc:Str Sorting.Later}" Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).MoveWorkFolderDownCommand}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Str Sorting.RemoveWorkFolder}" Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).RemoveWorkFolderCommand}" CommandParameter="{Binding}" />
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Top" Classes="tertiary" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Text="{loc:Str Sorting.NoWorkFoldersHint}" IsVisible="{Binding HasNoWorkFolders}" />

                    <TextBox DockPanel.Dock="Top" x:Name="FolderSearchBox" AutomationProperties.Name="{loc:Str Sorting.FindFolder}" PlaceholderText="{loc:Str Sorting.FindFolder}" Text="{Binding FolderQuery, Mode=TwoWay}" Margin="0,0,0,6" />
                    <ListBox DockPanel.Dock="Top" x:Name="FolderResultsList" AutomationProperties.Name="{loc:Str Sorting.FoundFolders}" ItemsSource="{Binding FolderResults}" MaxHeight="180" Margin="0,0,0,6" IsVisible="{Binding !!FolderResults.Count}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="s:SortingFolderInfo">
                                <StackPanel Spacing="1" Margin="0,2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="tertiary" FontSize="11" Text="{Binding Path}" TextTrimming="PrefixCharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                        <Button AutomationProperties.Name="{loc:Str Sorting.NewFolder}" Classes="tool" Command="{Binding StartNewFolderCommand}" HotKey="Ctrl+Shift+N" ToolTip.Tip="{loc:Str Sorting.NewFolderTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="FolderAdd" FontSize="14" />
                                <TextBlock Text="{loc:Str Sorting.NewFolder}" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Sorting.PinAsWorkFolder}" Classes="tool" Command="{Binding PinDestinationCommand}" ToolTip.Tip="{loc:Str Sorting.PinAsWorkFolder}">
                            <ic:SymbolIcon Symbol="Pin" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <TextBox DockPanel.Dock="Bottom" x:Name="NewFolderBox" AutomationProperties.Name="{loc:Str Sorting.NewFolderName}" PlaceholderText="{loc:Str Sorting.NewFolderName}"
                             Text="{Binding NewFolderName, Mode=TwoWay}" IsVisible="{Binding IsNamingFolder}" Margin="0,6,0,0" />

                    <TreeView AutomationProperties.Name="{loc:Str Sorting.Subfolders}" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:SortFolderNode" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="{Binding IsNew, Converter={x:Static c:SortingConverters.FolderSymbol}}" FontSize="16" Foreground="{DynamicResource FolderIconBrush}" IsVisible="{Binding !IsPlaceholder}" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Полоса переноса (замечание пользователя 2026-10-12: было тесно и непонятно). Главное — куда и «Перенести»;
             имя и теги — по кнопкам, их редакторы во всплывающих панелях, а на кнопке видно, что задано. -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card" Padding="14,10" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="secondary" FontSize="12" Text="{loc:Str Sorting.To}" />
                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DestinationText}" ToolTip.Tip="{Binding DestinationText}" IsVisible="{Binding HasDestination}" />
                    <TextBlock Classes="secondary" TextTrimming="CharacterEllipsis" Text="{Binding DestinationText}" IsVisible="{Binding !HasDestination}" />
                    <TextBlock Classes="tertiary" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding DestinationAutoTagsText}" IsVisible="{Binding HasDestinationAutoTags}" />
                    <!-- Почему назначение выбрала подсказка (этапы 17.4–17.5): шаблон, история решений или недавний перенос -->
                    <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"
                               Text="{Binding DestinationReasonText}" ToolTip.Tip="{Binding DestinationReasonText}" IsVisible="{Binding HasDestinationReason}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Имя при переносе: как есть, своё имя или шаблон с подстановками -->
                    <Button x:Name="NameButton" Classes="option" Classes.set="{Binding HasNameTemplate}" MaxWidth="260"
                            AutomationProperties.Name="{Binding NameButtonText}" ToolTip.Tip="{loc:Str Sorting.NameButtonTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Rename" FontSize="16" />
                            <TextBlock Text="{Binding NameButtonText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Width="420" Spacing="8">
                                    <DockPanel>
                                        <ComboBox x:Name="PresetsBox" DockPanel.Dock="Right" MinWidth="160"
                                                  AutomationProperties.Name="{loc:Str Sorting.NamePresets}"
                                                  PlaceholderText="{loc:Str Sorting.NamePresets}"
                                                  ItemsSource="{Binding NamePresets}"
                                                  SelectedItem="{Binding SelectedNamePreset, Mode=TwoWay}" />
                                        <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Text="{loc:Str Sorting.NameOnMove}" />
                                    </DockPanel>
                                    <DockPanel>
                                        <DropDownButton DockPanel.Dock="Right" Margin="6,0,0,0" Content="{loc:Str Sorting.InsertToken}" ToolTip.Tip="{loc:Str Sorting.InsertTokenTip}">
                                            <DropDownButton.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="{loc:Str Sorting.Insert.nameTip}" Command="{Binding InsertNameTokenCommand}" CommandParameter="name" />
                                                    <MenuItem Header="{loc:Str Sorting.Insert.dateTip}" Command="{Binding InsertNameTokenCommand}" CommandParameter="date" />
                                                    <MenuItem Header="{loc:Str Sorting.Insert.timeTip}" Command="{Binding InsertNameTokenCommand}" CommandParameter="time" />
                                                    <MenuItem Header="{loc:Str Sorting.Insert.tagsTip}" Command="{Binding InsertNameTokenCommand}" CommandParameter="tags" />
                                                    <MenuItem Header="{loc:Str Sorting.Insert.folderTip}" Command="{Binding InsertNameTokenCommand}" CommandParameter="folder" />
                                                    <MenuItem Header="{loc:Str Sorting.Insert.nTip}" Command="{Binding InsertNameTokenCommand}" CommandParameter="n" />
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                        <TextBox x:Name="NameBox" AutomationProperties.Name="{loc:Str Sorting.NameOnMove}" PlaceholderText="{loc:Str Sorting.NameTemplatePlaceholder}" Text="{Binding NameTemplate, Mode=TwoWay}" />
                                    </DockPanel>
                                    <TextBlock Classes="secondary" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding NamePreview}" IsVisible="{Binding HasNamePreview}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="tool" Content="{loc:Str Sorting.ClearName}" Command="{Binding ClearNameTemplateCommand}" IsVisible="{Binding HasNameTemplate}" />
                                        <TextBlock Classes="tertiary" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:Str Sorting.NameHint}" />
                                    </DockPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Теги для переносимого -->
                    <Button x:Name="TagsButton" Classes="option" Classes.set="{Binding HasTags}" MaxWidth="260"
                            AutomationProperties.Name="{Binding TagsButtonText}" ToolTip.Tip="{loc:Str Sorting.TagsButtonTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Tag" FontSize="16" />
                            <TextBlock Text="{Binding TagsButtonText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Width="380" Spacing="8">
                                    <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" Text="{loc:Str Sorting.Tags}" />
                                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="tag" Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        <Button Classes="tool" Padding="2" MinWidth="0" MinHeight="0"
                                                                AutomationProperties.Name="{loc:Str Sorting.RemoveTag}" ToolTip.Tip="{loc:Str Sorting.RemoveTag}"
                                                                Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).RemoveTagCommand}" CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="Dismiss" FontSize="10" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBox x:Name="TagBox" AutomationProperties.Name="{loc:Str Sorting.Tags}" PlaceholderText="{loc:Str Sorting.TagWatermark}" Text="{Binding TagText, Mode=TwoWay}" />
                                    <ItemsControl ItemsSource="{Binding TagSuggestions}" IsVisible="{Binding !!TagSuggestions.Count}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Classes="tool" Margin="0,0,4,4" Content="{Binding}"
                                                        Command="{Binding $parent[UserControl].((vm:SortingViewModel)DataContext).AddTagCommand}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="tool" Content="{loc:Str Sorting.ClearTags}" Command="{Binding ClearTagsCommand}" IsVisible="{Binding HasTags}" />
                                        <TextBlock Classes="tertiary" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Text="{loc:Str Sorting.TagsHint}" />
                                    </DockPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Button Grid.Column="2" Classes="accent" MinWidth="200" MinHeight="36" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                        Content="{Binding MoveText}" Command="{Binding MoveCommand}" HotKey="Ctrl+Enter"
                        ToolTip.Tip="{loc:Str Sorting.MoveTip}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Classes="secondary" FontSize="12" Margin="4,8,0,0" Text="{Binding ItemsText}" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="tertiary" FontSize="12" Margin="8,8,0,0" HorizontalAlignment="Right" Text="{loc:Str Sorting.KeysHint}" />
    </Grid>
</UserControl>
