<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:input="using:DiskApp.UI.Input"
             xmlns:m="using:DiskApp.UI.Models"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="460"
             x:Class="DiskApp.UI.Views.QuickSearchView"
             x:DataType="vm:QuickSearchViewModel"
             Design.DataContext="{x:Static vm:DesignData.QuickSearch}">
    <!-- Содержимое быстрого поиска: поле ввода, список результатов (при пустом запросе — по секциям) или «ничего
         не найдено», панель переименования и подтверждения корзины, уведомление об итоге действия, строка состояния.
         Клавиши разбирает карта QuickSearchKeyMap в code-behind на этапе туннелирования, чтобы стрелки управляли
         списком, а фокус оставался в поле ввода. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBox Grid.Row="0"
                 x:Name="QueryBox"
                 Classes="search"
                 Text="{Binding Query, Mode=TwoWay}"
                 PlaceholderText="Найти файл или папку…">
            <TextBox.InnerLeftContent>
                <ic:SymbolIcon Symbol="Search"
                               FontSize="20"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <!-- Чипы фильтров: меняют текст запроса; Ctrl+F прячет и показывает. Кнопки не берут фокус у поля. -->
        <ItemsControl Grid.Row="1"
                      Margin="0,8,0,0"
                      ItemsSource="{Binding FilterChips}"
                      IsVisible="{Binding ShowFilters}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:FilterChip">
                    <Button Classes="filter"
                            Classes.active="{Binding IsActive}"
                            Focusable="False"
                            Content="{Binding Label}"
                            ToolTip.Tip="{Binding Token}"
                            Command="{Binding $parent[ItemsControl].((vm:QuickSearchViewModel)DataContext).ToggleFilterCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Подсказки: дополнение фильтра (Tab берёт первую) или прошлые запросы с удалением. -->
        <DockPanel Grid.Row="2" Margin="0,6,0,0" IsVisible="{Binding ShowSuggestions}">
            <TextBlock DockPanel.Dock="Left"
                       Classes="tertiary"
                       FontSize="12"
                       Margin="6,0,10,6"
                       VerticalAlignment="Center"
                       Text="{Binding SuggestionsTitle}" />
            <Button DockPanel.Dock="Right"
                    Classes="filter"
                    Focusable="False"
                    VerticalAlignment="Top"
                    Content="Очистить"
                    Command="{Binding ClearHistoryCommand}"
                    IsVisible="{Binding IsShowingHistory}" />
            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:QuerySuggestion">
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,6">
                            <Button Classes="suggestion"
                                    Classes.history="{Binding IsHistory}"
                                    Focusable="False"
                                    Content="{Binding Display}"
                                    Command="{Binding $parent[ItemsControl].((vm:QuickSearchViewModel)DataContext).ApplySuggestionCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Classes="remove"
                                    Focusable="False"
                                    IsVisible="{Binding IsHistory}"
                                    ToolTip.Tip="Удалить из истории"
                                    Command="{Binding $parent[ItemsControl].((vm:QuickSearchViewModel)DataContext).DeleteHistoryCommand}"
                                    CommandParameter="{Binding}">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <Panel Grid.Row="3" Margin="0,8,0,0">
            <ListBox x:Name="ResultsList"
                     Classes="results"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     ItemTemplate="{StaticResource ResultRowTemplate}"
                     SelectionMode="Single"
                     IsVisible="{Binding ShowResults}">
                <ListBox.ContextFlyout>
                    <!-- Подписи клавиш — текстом из QuickSearchKeyMap: стандартная подпись Avalonia называет Enter «Return». -->
                    <MenuFlyout>
                        <MenuItem Command="{Binding OpenCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Открыть" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.OpenText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="Open" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding RevealCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Показать в папке" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.RevealText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="FolderOpen" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding OpenWithCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Открыть с помощью…" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.OpenWithText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="WindowNew" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding CopyFilesCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Копировать" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.CopyFilesText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="Copy" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding CopyPathCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Копировать путь" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.CopyPathText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="DocumentCopy" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding TogglePinCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding PinMenuText}" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.TogglePinText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="Pin" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding BeginRenameCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Переименовать" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.RenameText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="Rename" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding BeginDeleteCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="В корзину" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.DeleteText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="Delete" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding RunAsAdminCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Запустить от имени администратора" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.RunAsAdminText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="Shield" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding PropertiesCommand}">
                            <MenuItem.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Свойства" />
                                    <TextBlock Grid.Column="1" Classes="gesture" Text="{x:Static input:QuickSearchKeyMap.PropertiesText}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.Icon><ic:SymbolIcon Symbol="Info" /></MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </ListBox.ContextFlyout>
            </ListBox>
            <StackPanel IsVisible="{Binding ShowEmptyState}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <ic:SymbolIcon Symbol="DocumentSearch"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Classes="secondary" Text="Ничего не найдено" HorizontalAlignment="Center" />
                <TextBlock Classes="tertiary" FontSize="12" Text="Введите ?, чтобы увидеть фильтры и клавиши" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Подсказка синтаксиса по запросу «?» -->
            <ScrollViewer IsVisible="{Binding ShowHelp}">
                <ItemsControl ItemsSource="{x:Static input:SearchHelp.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:HelpItem">
                            <Panel>
                                <TextBlock Classes="section" Margin="6,10,0,4" Text="{Binding Description}" IsVisible="{Binding IsHeader}" />
                                <Grid ColumnDefinitions="220,*" Margin="6,3" IsVisible="{Binding !IsHeader}">
                                    <TextBlock Classes="code" Text="{Binding Example}" />
                                    <TextBlock Grid.Column="1" Classes="secondary" TextWrapping="Wrap" Text="{Binding Description}" />
                                </Grid>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>

        <!-- Панель действия: новое имя (F2) или подтверждение корзины (Del). Enter — да, Esc — отмена. -->
        <Border Grid.Row="4"
                Margin="0,8,0,0"
                Padding="12,10"
                CornerRadius="6"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                IsVisible="{Binding HasPendingAction}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding PendingPrompt}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="12,0,0,0"
                            VerticalAlignment="Bottom">
                    <Button Classes="accent"
                            Content="{Binding PendingConfirmText}"
                            Command="{Binding ConfirmPendingActionCommand}" />
                    <Button Content="Отмена" Command="{Binding CancelPendingActionCommand}" />
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="0"
                         x:Name="RenameBox"
                         Margin="0,8,0,0"
                         Text="{Binding RenameText, Mode=TwoWay}"
                         IsVisible="{Binding IsRenaming}" />
            </Grid>
        </Border>

        <ui:FAInfoBar Grid.Row="5"
                      Margin="0,8,0,0"
                      IsOpen="{Binding IsNoticeOpen, Mode=TwoWay}"
                      Title="{Binding NoticeTitle}"
                      Message="{Binding NoticeMessage}"
                      Severity="{Binding NoticeSeverity}"
                      IsClosable="True" />

        <DockPanel Grid.Row="6" Margin="6,8,6,0">
            <TextBlock DockPanel.Dock="Right"
                       Classes="tertiary"
                       FontSize="12"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="Enter открыть · Tab меню · ? справка · Esc закрыть" />
            <Button DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Padding="10,2"
                    FontSize="12"
                    Content="Повторить"
                    Command="{Binding RetryCommand}"
                    IsVisible="{Binding HasError}" />
            <ic:SymbolIcon DockPanel.Dock="Left"
                           Symbol="ErrorCircle"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           IsVisible="{Binding HasError}" />
            <TextBlock Classes="secondary"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding StatusText}"
                       Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</UserControl>
