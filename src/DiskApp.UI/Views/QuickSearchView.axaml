<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="460"
             x:Class="DiskApp.UI.Views.QuickSearchView"
             x:DataType="vm:QuickSearchViewModel"
             Design.DataContext="{x:Static vm:DesignData.QuickSearch}">
    <!-- Содержимое быстрого поиска: поле ввода, список результатов (при пустом запросе — по секциям) или «ничего
         не найдено», строка состояния. Клавиши обрабатываются в code-behind на этапе туннелирования, чтобы стрелки
         управляли списком, а фокус оставался в поле ввода. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBox Grid.Row="0"
                 x:Name="QueryBox"
                 Classes="search"
                 Text="{Binding Query, Mode=TwoWay}"
                 PlaceholderText="Найти файл или папку…">
            <TextBox.InnerLeftContent>
                <ic:SymbolIcon Symbol="Search"
                               FontSize="20"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </TextBox.InnerLeftContent>
        </TextBox>

        <Panel Grid.Row="1" Margin="0,8,0,0">
            <ListBox x:Name="ResultsList"
                     Classes="results"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     ItemTemplate="{StaticResource ResultRowTemplate}"
                     SelectionMode="Single"
                     IsVisible="{Binding ShowResults}" />
            <StackPanel IsVisible="{Binding ShowEmptyState}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <ic:SymbolIcon Symbol="DocumentSearch"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Classes="secondary" Text="Ничего не найдено" HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>

        <DockPanel Grid.Row="2" Margin="6,8,6,0">
            <TextBlock DockPanel.Dock="Right"
                       Classes="tertiary"
                       FontSize="12"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="↑↓ выбрать · Enter открыть · Esc закрыть" />
            <Button DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Padding="10,2"
                    FontSize="12"
                    Content="Повторить"
                    Command="{Binding RetryCommand}"
                    IsVisible="{Binding HasError}" />
            <ic:SymbolIcon DockPanel.Dock="Left"
                           Symbol="ErrorCircle"
                           FontSize="14"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           IsVisible="{Binding HasError}" />
            <TextBlock Classes="secondary"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding StatusText}"
                       Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</UserControl>
