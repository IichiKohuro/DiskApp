<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="480"
             x:Class="DiskApp.UI.Views.WhatsNewView"
             x:DataType="vm:WhatsNewViewModel">
    <!-- «Что нового» (PLAN.md, этап 9.3): пункты текущей версии; кнопка закрытия — у диалога. -->
    <ScrollViewer MaxHeight="440" Width="500">
        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,16,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WhatsNewItem">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                        <ic:SymbolIcon Symbol="{Binding Symbol}" FontSize="22" Margin="0,2,14,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Text="{Binding Title}" />
                            <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Text}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
