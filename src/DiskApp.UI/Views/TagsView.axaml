<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:DiskApp.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:m="using:DiskApp.UI.Models"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="DiskApp.UI.Views.TagsView"
             x:DataType="vm:TagsViewModel">
    <!-- Страница «Теги» (PLAN.md, этап 8.7): слева теги с цветами, справа файлы выбранного тега (поиск tag:). -->
    <Grid Margin="16,12,16,8" RowDefinitions="Auto,*,Auto" ColumnDefinitions="260,*">
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                <Button Classes="tool" Command="{Binding CreateTagCommand}" ToolTip.Tip="{loc:Str Tags.NewTag}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Add" FontSize="16" />
                        <TextBlock Text="{loc:Str Tags.NewTag}" />
                    </StackPanel>
                </Button>
                <Button Classes="tool" Command="{Binding EditTagCommand}" ToolTip.Tip="{loc:Str Tags.RenameOrChangeColor}">
                    <ic:SymbolIcon Symbol="Edit" FontSize="16" />
                </Button>
                <Button Classes="tool" Command="{Binding DeleteTagCommand}" ToolTip.Tip="{loc:Str Tags.DeleteTagFilesStay}">
                    <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                </Button>
                <Button Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Str Common.RefreshF5}">
                    <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16" />
                </Button>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Theme="{StaticResource TitleLargeTextBlockStyle}" Text="{loc:Str Common.Page.Tags}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Str Tags.LabelsForFilesFromDifferentPlaces}" />
            </StackPanel>
        </DockPanel>

        <!-- Теги -->
        <Border Grid.Row="1" Classes="card" Padding="6">
            <Panel>
                <ListBox x:Name="TagsList" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:TagInfo">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                                <Ellipse Classes="swatch" Fill="{Binding Color, Converter={x:Static c:TagConverters.Brush}}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Spacing="8" Margin="12" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}">
                    <ic:SymbolIcon Symbol="TagMultiple" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" Text="{loc:Str Tags.NoTagsYet}" />
                    <TextBlock Classes="tertiary" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Text="{loc:Str Tags.CreateATagHereOrTag}" />
                </StackPanel>
            </Panel>
        </Border>

        <!-- Файлы тега -->
        <Border Grid.Row="1" Grid.Column="1" Classes="card" Padding="8" Margin="8,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Theme="{StaticResource BodyStrongTextBlockStyle}" Margin="6,2,6,8" Text="{Binding FilesTitle}" />
                <ListBox x:Name="FilesList"
                         Classes="results"
                         ItemsSource="{Binding Files}"
                         SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         ItemTemplate="{StaticResource FileHitTemplate}">
                    <ListBox.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="{loc:Str Common.Open}" Command="{Binding OpenFileCommand}" CommandParameter="{x:Null}" InputGesture="Enter" />
                            <MenuItem Header="{loc:Str Common.ShowInExplorer}" Command="{Binding RevealFileCommand}" />
                            <MenuItem Header="{loc:Str Common.TagsEllipsis}" Command="{Binding EditFileTagsCommand}" InputGesture="Ctrl+T" IsVisible="{Binding CanEditFileTags}" />
                        </MenuFlyout>
                    </ListBox.ContextFlyout>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="secondary" FontSize="12" Margin="4,8,0,0" Text="{Binding FilesText}" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="secondary" FontSize="12" Margin="4,8,0,0" HorizontalAlignment="Right"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </Grid>
</UserControl>
