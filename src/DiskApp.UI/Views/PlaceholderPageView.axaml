<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="DiskApp.UI.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel"
             Design.DataContext="{x:Static vm:DesignData.Placeholder}">
    <!-- Страница, которой пока нет: что здесь появится и в каком этапе. -->
    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*" MaxWidth="{StaticResource PageMaxWidth}">
        <TextBlock Grid.Row="0" Theme="{StaticResource TitleLargeTextBlockStyle}" Text="{Binding Title}" />
        <Border Grid.Row="1" Classes="card" Margin="0,16,0,0" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="520">
                <Border Width="88" Height="88"
                        CornerRadius="44"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ic:SymbolIcon Symbol="{Binding Illustration}"
                                   FontSize="44"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Theme="{StaticResource SubtitleTextBlockStyle}" Text="{Binding Title}" HorizontalAlignment="Center" />
                <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" />
                <Border Classes="chip accent" HorizontalAlignment="Center" Padding="10,3">
                    <TextBlock Text="{Binding StageText}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
