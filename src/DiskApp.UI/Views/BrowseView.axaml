<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:c="using:DiskApp.UI.Controls"
             xmlns:m="using:DiskApp.UI.Models"
             xmlns:views="using:DiskApp.UI.Views"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="DiskApp.UI.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">
    <!-- Обзор папок (PLAN.md, этап 8.3): панель команд с адресной строкой и фильтрами, крошки, дерево корней и папок
         слева, содержимое папки списком или плиткой, сведения о выбранном справа, строка состояния внизу.
         Клавиши как в Проводнике: Backspace / Alt+← — назад, Alt+→ — вперёд, Alt+↑ — выше, Enter — открыть,
         Ctrl+L — адресная строка, F2 — переименовать, Del — в корзину, F5 — обновить. -->
    <Grid Margin="16,12,16,8" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="240,*,Auto">

        <!-- Панель команд -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                <Button Classes="tool" Command="{Binding GoBackCommand}" IsEnabled="{Binding CanGoBack}" ToolTip.Tip="{loc:Str Browse.BackAlt}">
                    <ic:SymbolIcon Symbol="ArrowLeft" FontSize="16" />
                </Button>
                <Button Classes="tool" Command="{Binding GoForwardCommand}" IsEnabled="{Binding CanGoForward}" ToolTip.Tip="{loc:Str Browse.ForwardAlt}">
                    <ic:SymbolIcon Symbol="ArrowRight" FontSize="16" />
                </Button>
                <Button Classes="tool" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip.Tip="{loc:Str Browse.UpOneLevelAlt}">
                    <ic:SymbolIcon Symbol="ArrowUp" FontSize="16" />
                </Button>
                <Button Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Str Common.RefreshF5}">
                    <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16" />
                </Button>
                <Button Classes="tool" ToolTip.Tip="{loc:Str Browse.CreateAFolderCtrlShiftN}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Add" FontSize="16" />
                        <TextBlock Text="{loc:Str Common.Create}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{loc:Str Browse.Folder}" Command="{Binding NewFolderCommand}" InputGesture="Ctrl+Shift+N" />
                            <Separator />
                            <MenuItem Header="{loc:Str Browse.TextDocumentTxt}" Command="{Binding NewFileCommand}" CommandParameter="{Binding FileTemplates[0]}" />
                            <MenuItem Header="{loc:Str Browse.MarkdownNoteMd}" Command="{Binding NewFileCommand}" CommandParameter="{Binding FileTemplates[1]}" />
                            <MenuItem Header="JSON (.json)" Command="{Binding NewFileCommand}" CommandParameter="{Binding FileTemplates[2]}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <TextBox x:Name="AddressBox" Text="{Binding AddressText, Mode=TwoWay}" PlaceholderText="{loc:Str Browse.FolderPathInsideTheRootsCtrl}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding GoToAddressCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </DockPanel>

        <!-- Крошки -->
        <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="8,0,0,8" VerticalAlignment="Center">
                <TextBox Width="140" PlaceholderText="{loc:Str Browse.FilterInFolder}" Text="{Binding Filter, Mode=TwoWay}" />
                <ComboBox Width="120" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" ToolTip.Tip="{loc:Str Browse.FileKind}" />
                <ComboBox Width="140" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" ToolTip.Tip="{loc:Str Browse.Sort}" />
                <ToggleButton Classes="tool" IsChecked="{Binding Descending, Mode=TwoWay}" ToolTip.Tip="{loc:Str Browse.Descending}">
                    <ic:SymbolIcon Symbol="ArrowSortDown" FontSize="16" />
                </ToggleButton>
                <ToggleButton Classes="tool" IsChecked="{Binding IsTiles, Mode=TwoWay}" ToolTip.Tip="{loc:Str Browse.Tiles}">
                    <ic:SymbolIcon Symbol="Grid" FontSize="16" />
                </ToggleButton>
            </StackPanel>
            <ui:FABreadcrumbBar x:Name="Breadcrumbs"
                                Margin="8,0,0,8"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Crumbs}" />
        </DockPanel>

        <!-- Дерево корней и папок -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Classes="card" Padding="4">
            <TreeView x:Name="FolderTree" ItemsSource="{Binding Tree}">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:FolderNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:FolderNode" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Содержимое папки -->
        <Border Grid.Row="2" Grid.Column="1" Classes="card" Padding="8" Margin="8,0,0,0">
            <Panel>
                <ListBox x:Name="ItemsList"
                         Classes="results"
                         ItemsSource="{Binding Items}"
                         ItemTemplate="{StaticResource FileHitTemplate}"
                         SelectionMode="Multiple"
                         IsVisible="{Binding !IsTiles}" />
                <ListBox x:Name="TilesList"
                         Classes="tiles"
                         ItemsSource="{Binding Items}"
                         SelectionMode="Multiple"
                         IsVisible="{Binding IsTiles}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:SearchHit">
                            <StackPanel Width="112" Spacing="6">
                                <c:FileIcon Width="72" Height="72"
                                            HorizontalAlignment="Center"
                                            CornerRadius="8"
                                            IconSize="56"
                                            PreferThumbnail="True"
                                            Entry="{Binding Entry}"
                                            Symbol="{Binding Symbol}"
                                            FallbackBackground="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Entry.Name}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ui:FAProgressRing IsIndeterminate="True" Width="40" Height="40" IsVisible="{Binding IsLoading}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasEmptyHint" />
                            <Binding Path="!IsLoading" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <ic:SymbolIcon Symbol="FolderOpen" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Text="{Binding EmptyHint}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding HasError}">
                    <ic:SymbolIcon Symbol="FolderProhibited" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Text="{Binding ErrorText}" />
                </StackPanel>
            </Panel>
        </Border>

        <!-- Сведения о выбранном -->
        <Border Grid.Row="2" Grid.Column="2" x:Name="DetailsCard" Classes="card" Width="280" Padding="16" Margin="8,0,0,0">
            <Panel>
                <TextBlock Classes="tertiary"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{loc:Str Browse.SelectOneFileItsDetailsAppear}"
                           IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNull}}" />
                <ScrollViewer IsVisible="{Binding SelectedDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="12">
                        <views:FileDetailsView DataContext="{Binding SelectedDetails}" />
                        <Button Classes="accent" HorizontalAlignment="Stretch" Content="{loc:Str Common.Open}" Command="{Binding OpenItemCommand}" CommandParameter="{Binding Selection[0]}" />
                        <Button HorizontalAlignment="Stretch" Content="{loc:Str Common.ShowInExplorer}" Command="{Binding RevealCommand}" />
                        <Button HorizontalAlignment="Stretch" Content="{loc:Str Common.CopyPath}" Command="{Binding CopyPathCommand}" />
                        <Button HorizontalAlignment="Stretch" Content="{loc:Str Common.Properties}" Command="{Binding PropertiesCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>

        <!-- Строка состояния -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="secondary" FontSize="12" Margin="4,8,0,0" Text="{Binding StatusText}" />
    </Grid>

    <UserControl.ContextFlyout>
        <MenuFlyout>
            <MenuItem Header="{loc:Str Common.Open}" Command="{Binding OpenItemCommand}" CommandParameter="{Binding Selection[0]}" />
            <MenuItem Header="{loc:Str Common.ShowInExplorer}" Command="{Binding RevealCommand}" />
            <Separator />
            <MenuItem Header="{loc:Str Browse.Cut2}" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
            <MenuItem Header="{loc:Str Common.Copy}" Command="{Binding CopyFilesCommand}" InputGesture="Ctrl+C" />
            <MenuItem Header="{loc:Str Browse.Paste}" Command="{Binding PasteFromAppCommand}" InputGesture="Ctrl+V" IsEnabled="{Binding HasClipboard}" />
            <MenuItem Header="{loc:Str Common.CopyPath}" Command="{Binding CopyPathCommand}" />
            <Separator />
            <MenuItem Header="{loc:Str Browse.NewFolder}" Command="{Binding NewFolderCommand}" InputGesture="Ctrl+Shift+N" />
            <Separator />
            <MenuItem Header="{loc:Str Common.PinOrUnpin}" Command="{Binding TogglePinCommand}" InputGesture="Ctrl+D" />
            <MenuItem Header="{loc:Str Common.TagsEllipsis}" Command="{Binding EditTagsCommand}" InputGesture="Ctrl+T" IsVisible="{Binding CanEditTags}" />
            <MenuItem Header="{loc:Str Common.RenameEllipsis}" Command="{Binding RenameCommand}" />
            <MenuItem Header="{loc:Str Browse.MoveToRecycleBin}" Command="{Binding DeleteCommand}" />
            <Separator />
            <MenuItem Header="{loc:Str Common.Properties}" Command="{Binding PropertiesCommand}" />
        </MenuFlyout>
    </UserControl.ContextFlyout>
</UserControl>
