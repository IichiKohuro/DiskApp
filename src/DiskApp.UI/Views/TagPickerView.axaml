<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:DiskApp.UI.Controls"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="380"
             x:Class="DiskApp.UI.Views.TagPickerView"
             x:DataType="vm:TagPickerViewModel">
    <!-- Диалог тегов (PLAN.md, этап 8.7): отметки тегов для одного или нескольких файлов, новый тег с цветом из палитры.
         Кнопки — у диалога. -->
    <StackPanel Spacing="10" Width="400">
        <TextBlock Classes="secondary" TextTrimming="CharacterEllipsis" Text="{Binding TargetText}" />
        <ScrollViewer MaxHeight="260">
            <ItemsControl ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagChoice">
                        <CheckBox AutomationProperties.Name="{Binding Tag.Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="{Binding IsThreeState}" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Classes="swatch" Fill="{Binding Tag.Color, Converter={x:Static c:TagConverters.Brush}}" />
                                <TextBlock Text="{Binding Tag.Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Classes="tertiary" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                   Text="{loc:Str TagPicker.NoTagsYetTypeAName}" />
        <!-- Авто-теги папок (этап 19): видны, но снимаются у папки — к ней ведёт кнопка -->
        <StackPanel Spacing="4" IsVisible="{Binding HasInherited}">
            <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{loc:Str TagPicker.InheritedTitle}" />
            <ItemsControl ItemsSource="{Binding Inherited}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InheritedTagGroup">
                        <DockPanel Margin="0,2">
                            <Button DockPanel.Dock="Right" Classes="tool" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Content="{loc:Str TagPicker.GoToFolder}" ToolTip.Tip="{Binding Folder}"
                                    AutomationProperties.Name="{loc:Str TagPicker.GoToFolder}"
                                    Command="{Binding $parent[UserControl].((vm:TagPickerViewModel)DataContext).GoToFolderCommand}" CommandParameter="{Binding Folder}" />
                            <TextBlock DockPanel.Dock="Left" Classes="tertiary" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                       MaxWidth="140" TextTrimming="CharacterEllipsis" Text="{Binding FolderName}" />
                            <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagChipTemplate}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox AutomationProperties.Name="{loc:Str TagPicker.NewTag}" x:Name="NewTagBox" PlaceholderText="{loc:Str TagPicker.NewTag}" Text="{Binding NewTagName, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="{loc:Str TagPicker.Add}" Command="{Binding AddTagCommand}" />
        </Grid>
        <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
</UserControl>
