<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="80"
             x:Class="DiskApp.UI.Views.FileHistoryRow"
             x:DataType="vm:FileHistoryItemViewModel">
    <!-- Строка истории файлов (PLAN.md, этап 20.4): значок вида, имя и время, что случилось, кто сделал и «Вернуть на место»
         или «Восстановить». Общая для страницы «История» и панели «История» в карточке файла. -->
    <Border Classes="card" Padding="12,8">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <ic:SymbolIcon Grid.RowSpan="3"
                           Symbol="{Binding Symbol}"
                           FontSize="20"
                           Margin="0,2,12,0"
                           VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Right" Classes="tertiary" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding TimeText}" />
                <TextBlock Theme="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding PathText}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding ActionText}" ToolTip.Tip="{Binding PathText}" />
            <WrapPanel Grid.Row="2" Grid.Column="1" ItemSpacing="8" LineSpacing="6" Margin="0,6,0,0">
                <Border Classes="chip" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Text="{Binding SourceText}" />
                </Border>
                <Button Content="{Binding RevertText}" Command="{Binding RevertCommand}" IsVisible="{Binding CanRevert}" Padding="10,3" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
