<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DiskApp.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:DiskApp.UI.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:v="using:DiskApp.UI.Views"
             xmlns:vm="using:DiskApp.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="DiskApp.UI.Views.NotesView"
             x:DataType="vm:NotesViewModel">
    <!-- Страница «Заметки» (PLAN.md, этап 23): слева список с поиском и фильтром по тегу, справа заметка — правка или
         просмотр Markdown, свои теги, закрепить, удалить. Редкое (корзина, правка тега) — в меню «Ещё». -->
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewNoteCommand}" />
    </UserControl.KeyBindings>
    <UserControl.Resources>
        <!-- Проект в выборе и отборе: иконка с номером и подпись -->
        <DataTemplate x:Key="ProjectChoiceTemplate" x:DataType="vm:NoteProjectChoice">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:ProjectBadge BadgeSize="18" VerticalAlignment="Center" Number="{Binding Project.Number}" Color="{Binding Project.Color}" IsVisible="{Binding HasProject}" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Колонки: список, разделитель (ширина списка запоминается), заметка -->
    <Grid x:Name="RootGrid" Margin="16,12,16,8" RowDefinitions="Auto,*">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="220" MaxWidth="700" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Classes="accent" Command="{Binding NewNoteCommand}" ToolTip.Tip="Ctrl+N"
                    AutomationProperties.Name="{loc:Str Notes.New}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="Add" FontSize="16" />
                    <TextBlock Text="{loc:Str Notes.New}" />
                </StackPanel>
            </Button>
            <StackPanel Spacing="4">
                <TextBlock Theme="{StaticResource TitleLargeTextBlockStyle}" Text="{loc:Str Notes.Title}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{loc:Str Notes.Description}" />
            </StackPanel>
        </DockPanel>

        <!-- Список -->
        <Border Grid.Row="1" Classes="card" Padding="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                    <TextBox AutomationProperties.Name="{loc:Str Notes.Search}" PlaceholderText="{loc:Str Notes.Search}" Text="{Binding SearchText, Mode=TwoWay}" />
                    <Button Grid.Column="1" Classes="tool" AutomationProperties.Name="{loc:Str Notes.More}" ToolTip.Tip="{loc:Str Notes.More}">
                        <ic:SymbolIcon Symbol="MoreHorizontal" FontSize="16" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:Str Notes.Trash}" Command="{Binding ToggleTrashCommand}" IsVisible="{Binding !ShowTrash}" />
                                <MenuItem Header="{loc:Str Notes.BackToNotes}" Command="{Binding ToggleTrashCommand}" IsVisible="{Binding ShowTrash}" />
                                <Separator IsVisible="{Binding HasTagFilter}" />
                                <MenuItem Header="{loc:Str Notes.EditTag}" Command="{Binding EditTagCommand}" IsVisible="{Binding HasTagFilter}" />
                                <MenuItem Header="{loc:Str Notes.DeleteTag}" Command="{Binding DeleteTagCommand}" IsVisible="{Binding HasTagFilter}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <!-- Отбор по проекту (этап 24) — только если проекты есть -->
                <ComboBox DockPanel.Dock="Top" HorizontalAlignment="Stretch" Margin="0,0,0,6" AutomationProperties.Name="{loc:Str Notes.ProjectFilter}"
                          ItemsSource="{Binding ProjectFilters}" SelectedItem="{Binding SelectedProjectFilter, Mode=TwoWay}" ItemTemplate="{StaticResource ProjectChoiceTemplate}">
                    <ComboBox.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasProjects" />
                            <Binding Path="!ShowTrash" />
                        </MultiBinding>
                    </ComboBox.IsVisible>
                </ComboBox>
                <ComboBox DockPanel.Dock="Top" HorizontalAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="{loc:Str Notes.TagFilter}"
                          ItemsSource="{Binding TagFilters}" SelectedItem="{Binding SelectedTagFilter, Mode=TwoWay}" IsVisible="{Binding !ShowTrash}" />
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="2,0,2,8" IsVisible="{Binding ShowTrash}">
                    <Button Classes="tool" Command="{Binding ToggleTrashCommand}" AutomationProperties.Name="{loc:Str Notes.BackToNotes}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ArrowLeft" FontSize="14" />
                            <TextBlock Text="{loc:Str Notes.BackToNotes}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{loc:Str Notes.TrashHint}" />
                </StackPanel>
                <Panel>
                    <ListBox AutomationProperties.Name="{loc:Str Notes.Title}" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NoteItem">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <DockPanel>
                                        <ic:SymbolIcon DockPanel.Dock="Right" Symbol="Pin" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsPinned}"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <c:ProjectBadge DockPanel.Dock="Left" BadgeSize="18" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding HasProject}"
                                                        Number="{Binding Project.Number}" Color="{Binding Project.Color}" ToolTip.Tip="{Binding Project.DisplayName}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Classes="secondary" FontSize="12" Text="{Binding Snippet}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="tertiary" FontSize="11" VerticalAlignment="Center" Text="{Binding ModifiedText}" />
                                        <ItemsControl ItemsSource="{Binding TagLabels}" ItemTemplate="{StaticResource TagChipTemplate}" IsVisible="{Binding HasTags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240"
                               Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
                </Panel>
            </DockPanel>
        </Border>

        <!-- Разделитель: ширина списка тянется мышью и запоминается -->
        <GridSplitter x:Name="ListSplitter" Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Background="Transparent"
                      AutomationProperties.Name="{loc:Str Notes.ListWidth}" ToolTip.Tip="{loc:Str Notes.ListWidth}" />
        <Border Grid.Row="1" Grid.Column="1" Width="3" Height="36" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.5" />

        <!-- Заметка -->
        <Border Grid.Row="1" Grid.Column="2" Classes="card" Padding="12">
            <Panel>
                <DockPanel IsVisible="{Binding HasNote}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                            <Button Classes="tool" Content="{Binding PreviewToggleText}" Command="{Binding TogglePreviewCommand}" IsVisible="{Binding CanEdit}" />
                            <ToggleButton Classes="tool" IsChecked="{Binding IsPinned, Mode=OneWay}" Command="{Binding TogglePinCommand}" IsVisible="{Binding CanEdit}"
                                          AutomationProperties.Name="{loc:Str Notes.Pin}" ToolTip.Tip="{loc:Str Notes.Pin}">
                                <ic:SymbolIcon Symbol="Pin" FontSize="16" />
                            </ToggleButton>
                            <Button Classes="tool" Command="{Binding DeleteCommand}" IsVisible="{Binding CanEdit}"
                                    AutomationProperties.Name="{loc:Str Notes.Delete}" ToolTip.Tip="{loc:Str Notes.Delete}">
                                <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                            </Button>
                            <Button Classes="accent" Content="{loc:Str Notes.Restore}" Command="{Binding RestoreCommand}" IsVisible="{Binding ShowTrash}" />
                            <Button Content="{loc:Str Notes.DeleteForever}" Command="{Binding DeleteForeverCommand}" IsVisible="{Binding ShowTrash}" />
                        </StackPanel>
                        <!-- Проект заметки (этап 24): привязка — в самой заметке -->
                        <ComboBox DockPanel.Dock="Left" Width="200" Margin="0,0,8,0" VerticalAlignment="Top" AutomationProperties.Name="{loc:Str Notes.Project}" ToolTip.Tip="{loc:Str Notes.Project}"
                                  ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" ItemTemplate="{StaticResource ProjectChoiceTemplate}">
                            <ComboBox.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasProjects" />
                                    <Binding Path="CanEdit" />
                                </MultiBinding>
                            </ComboBox.IsVisible>
                        </ComboBox>
                        <!-- Теги заметки: чипы и поле с подсказками из тегов заметок -->
                        <v:AutoTagsEditorView DataContext="{Binding TagsEditor}" IsVisible="{Binding $parent[UserControl].((vm:NotesViewModel)DataContext).CanEdit}" Margin="0,0,12,0" />
                    </DockPanel>
                    <!-- Панель форматирования (просьба пользователя «чтобы было просто и удобно»): работает с выделением в поле;
                         кнопки не забирают фокус, поэтому выделение не теряется. -->
                    <StackPanel x:Name="FormatBar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,0,0,6" IsVisible="{Binding IsEditing}">
                        <StackPanel.Styles>
                            <Style Selector="Button.format">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="6" />
                                <Setter Property="MinWidth" Value="32" />
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                            <Style Selector="Border.format-separator">
                                <Setter Property="Width" Value="1" />
                                <Setter Property="Margin" Value="4,6" />
                                <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            </Style>
                        </StackPanel.Styles>
                        <Button Classes="tool format" Tag="Heading" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Heading}" ToolTip.Tip="{loc:Str Notes.Format.Heading}">
                            <ic:SymbolIcon Symbol="TextHeader1" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="Bold" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Bold}" ToolTip.Tip="{loc:Str Notes.Format.Bold}">
                            <ic:SymbolIcon Symbol="TextBold" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="Italic" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Italic}" ToolTip.Tip="{loc:Str Notes.Format.Italic}">
                            <ic:SymbolIcon Symbol="TextItalic" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="Strikethrough" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Strikethrough}" ToolTip.Tip="{loc:Str Notes.Format.Strikethrough}">
                            <ic:SymbolIcon Symbol="TextStrikethrough" FontSize="18" />
                        </Button>
                        <Border Classes="format-separator" />
                        <Button Classes="tool format" Tag="BulletList" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.BulletList}" ToolTip.Tip="{loc:Str Notes.Format.BulletList}">
                            <ic:SymbolIcon Symbol="TextBulletList" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="NumberedList" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.NumberedList}" ToolTip.Tip="{loc:Str Notes.Format.NumberedList}">
                            <ic:SymbolIcon Symbol="TextNumberList" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="TaskList" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.TaskList}" ToolTip.Tip="{loc:Str Notes.Format.TaskList}">
                            <ic:SymbolIcon Symbol="TextBulletListCheckmark" FontSize="18" />
                        </Button>
                        <Border Classes="format-separator" />
                        <Button Classes="tool format" Tag="Quote" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Quote}" ToolTip.Tip="{loc:Str Notes.Format.Quote}">
                            <ic:SymbolIcon Symbol="TextQuote" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="Code" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Code}" ToolTip.Tip="{loc:Str Notes.Format.Code}">
                            <ic:SymbolIcon Symbol="Code" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="Link" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Link}" ToolTip.Tip="{loc:Str Notes.Format.Link}">
                            <ic:SymbolIcon Symbol="Link" FontSize="18" />
                        </Button>
                        <Button Classes="tool format" Tag="Divider" Click="OnFormatClick" AutomationProperties.Name="{loc:Str Notes.Format.Divider}" ToolTip.Tip="{loc:Str Notes.Format.Divider}">
                            <ic:SymbolIcon Symbol="LineHorizontal1" FontSize="18" />
                        </Button>
                    </StackPanel>
                    <Panel>
                        <TextBox x:Name="Editor" AutomationProperties.Name="{loc:Str Notes.Text}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" PlaceholderText="{loc:Str Notes.EditorPlaceholder}"
                                 Text="{Binding Body, Mode=TwoWay}" IsVisible="{Binding IsEditing}" />
                        <ScrollViewer IsVisible="{Binding !IsEditing}">
                            <c:MarkdownView x:Name="Preview" Markdown="{Binding Body}" Margin="2,0,8,0" />
                        </ScrollViewer>
                    </Panel>
                </DockPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding !HasNote}">
                    <ic:SymbolIcon Symbol="Note" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Text="{loc:Str Notes.NothingOpen}" />
                    <Button HorizontalAlignment="Center" Classes="accent" Content="{loc:Str Notes.New}" Command="{Binding NewNoteCommand}" IsVisible="{Binding !ShowTrash}" />
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
