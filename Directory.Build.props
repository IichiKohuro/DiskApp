<Project>

  <!-- Общие настройки всех проектов решения. Подробности: PLAN.md, этап 0.3; docs/ARCHITECTURE.md, раздел 15. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- Качество кода: предупреждения — это ошибки, анализаторы на рекомендуемом уровне, стиль из .editorconfig проверяется при сборке. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Уязвимости в зависимостях остаются предупреждениями: о них сообщает NuGet, но они не должны внезапно ломать сборку. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Метаданные сборок. Версию из git (MinVer) добавляет этап 11. -->
  <PropertyGroup>
    <Authors>Iichi Kohuro</Authors>
    <Product>DiskApp</Product>
    <Copyright>Copyright (c) 2026 Iichi Kohuro</Copyright>
    <RepositoryUrl>https://github.com/IichiKohuro/DiskApp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <VersionPrefix>0.1.0</VersionPrefix>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Воспроизводимая сборка в CI: пути в PDB нормализуются, source link не зависит от машины. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
